et_jobs(det_leak_jobs, reserve_h=0.5)\n","\n","det_leak = []\n","for v, f, s in det_leak_jobs:\n","    p = OUT / \"det_runs\" / f\"{v}_{CFG['det_label_def']}_{DET_ID}_s{s}_f{f['fold']}\" / \"metrics.json\"\n","    if p.exists():\n","        det_leak.append(json.loads(p.read_text()))\n","det_leak = pd.DataFrame(det_leak)\n","if len(det_df):                                   # patient-grouped = main-grid raw runs with the same seed\n","    det_leak = pd.concat([det_leak, det_df[(det_df.variant == \"raw\") & (det_df.seed == CFG[\"det_seeds\"][0])].assign(regime=\"patient_grouped\")],\n","                         ignore_index=True)\n","DET_LEAK_COMPLETE = sum(map(det_done, det_leak_jobs)) == len(det_leak_jobs)\n","print(f\"detector-leakage runs finished so far: {sum(map(det_done, det_leak_jobs))} / {len(det_leak_jobs)}\")\n","if len(det_leak):\n","    det_leak.to_csv(OUT / \"tables/partD_leakage_detection.csv\", index=False)\n","    display(det_leak.groupby(\"regime\")[[\"test_AP50\", \"test_F1\", \"test_center_F1\", \"test_video_AUROC\"]]\n","            .agg([\"mean\", \"std\", \"count\"]).round(3)\n","            .reindex([r for r in [\"frame_random\", \"video_grouped\", \"patient_grouped\"] if r in set(det_leak.regime)]))\n"]},{"cell_type":"markdown","id":"85b90a7f","metadata":{"papermill":{"duration":0.033354,"end_time":"2026-11-18T13:53:09.234265+00:00","exception":false,"start_time":"2026-11-18T13:53:09.200911+00:00","status":"completed"},"tags":[]},"source":["## 12. Error analysis\n","Detection misses by grade and box size, using the pooled out-of-fold predictions of the best and the baseline variants."]},{"cell_type":"code","execution_count":18,"id":"402f5d1b","metadata":{"execution":{"iopub.execute_input":"2026-11-18T13:53:09.305659Z","iopub.status.busy":"2026-11-18T13:53:09.305174Z","iopub.status.idle":"2026-11-18T13:53:16.352504Z","shell.execute_reply":"2026-11-18T13:53:16.351887Z"},"papermill":{"duration":7.084763,"end_time":"2026-11-18T13:53:16.354117+00:0