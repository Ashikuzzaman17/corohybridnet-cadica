quadratic\", labels=list(range(5)))\n","\n","def sev_unit(g, unit):\n","    \"\"\"Box level as is; track level = median predicted level vs the track's most frequent annotated level.\"\"\"\n","    if unit == \"track\":\n","        g = g.groupby(\"track\").agg(patient=(\"patient\", \"first\"), level=(\"level\", lambda s: s.mode().max()), p_exp=(\"p_exp\", \"median\")).reset_index()\n","    return g\n","\n","SEV_SUMMARY = {}\n","if len(sev_oof):\n","    arms = [a for a in SEV_ARMS if a in set(sev_oof.arm)]\n","    ens = sev_oof.groupby([\"arm\", \"uid\"]).agg(patient=(\"patient\", \"first\"), track=(\"track\", \"first\"), level=(\"level\", \"first\"),\n","                                              p_exp=(\"p_exp\", \"mean\"), n_seeds=(\"seed\", \"nunique\")).reset_index()\n","    rows, plot_rows = [], []\n","    for unit in (\"box\", \"track\"):\n","        per_seed_tab = sev_box if unit == \"box\" else sev_track\n","        for a in arms:\n","            g = sev_unit(ens[ens.arm == a], unit)\n","            est = patient_bootstrap(g, lambda d: qwk(d.level.values, d.p_exp.values), CFG[\"n_boot\"])\n","            mt = sev_metrics(g.level.values, g.p_exp.values)\n","            rows.append({\"Unit\": unit, \"Arm\": ARM_NAMES.get(a, a), \"n\": len(g), \"QWK [95% CI]\": ci_str(*est),\n","                         \"QWK per seed\": msd_str(per_seed_tab[per_seed_tab.arm == a].QWK) if len(per_seed_tab) else \"–\",\n","                         \"MAE\": round(mt[\"MAE\"], 3), \"Accuracy\": round(mt[\"acc\"], 3), \"Accuracy ±1\": round(mt[\"acc_pm1\"], 3),\n","                         \"Accuracy ≥50%\": round(mt[\"acc_ge50\"], 3), \"Accuracy ≥70%\": round(mt[\"acc_ge70\"], 3),\n","                         \"AUROC ≥70%\": round(mt[\"AUROC_ge70\"], 3)})\n","            plot_rows.append(dict(unit=unit, arm=a, qwk=est[0], lo=est[1], hi=est[2]))\n","            SEV_SUMMARY[f\"{unit}:{a}\"] = dict(QWK=[float(x) for x in est], **{k: float(v) for k, v in mt.items() if k != \"QWK\"})\n","    save_table(pd.DataFrame(rows), \"table4_severity\",\n","               \"Ordinal 5-level severity grading of ground-truth lesion boxes (patient-level 5-fold CV). Predictions are averaged over \"\n","               f\"{len(CFG['sev_seeds'])} seeds before scoring; QWK = quadratic-weighted κ with patient-cluster bootstrap 95% CI; \"\n","               \"'QWK per seed' = mean ± SD of the single-seed models. Track level: median prediction along the lesion track vs its \"\n","               \"most frequent annotated level (Part C). AUROC ≥70%: expected level as a score for ≥70% stenosis.\")\n","    KEY[\"severity\"] = SEV_SUMMARY\n","\n","    # ---- paired QWK differences vs the CNN baseline (same boxes / tracks) --------------------------------------------\n","    pr = []\n","    for unit, key in ((\"box\", \"uid\"), (\"track\", \"track\")):\n","        base = sev_unit(ens[ens.arm == \"cnn_raw\"], unit)\n","        for a in [a for a in arms if a != \"cnn_raw\"] if len(base) else []:\n","            d = sev_unit(ens[ens.arm == a], unit).merge(base[[key, \"p_exp\"]], on=key, suffixes=(\"\", \"_base\"))\n","            est = patient_bootstrap(d, lambda x: qwk(x.level.values, x.p_exp.values) - qwk(x.level.values, x.p_exp_base.values), CFG[\"n_boot\"])\n","            pr.append({\"Unit\": unit, \"Comparison\": f\"{ARM_NAMES.get(a, a)} − CNN (raw)\", \"n\": len(d), \"ΔQWK [95% CI]\": ci_str(*est),\n","                       \"Verdict\": \"better\" if est[1] > 0 else (\"worse\" if est[2] < 0 else \"no clear difference\")})\n","    if pr:\n","        save_table(pd.DataFrame(pr), \"table5_severity_paired\", \"Paired QWK differences against the CNN (raw) baseline on identical \"\n","                   \"boxes/tracks (patient-cluster bootstrap 95% CI). 'Better'/'worse' only when the CI excludes 0.\")\n","        KEY[\"severity_paired\"] = pr\n","\n","    # ---- Figure: QWK by arm, box vs track ---------------------------------------------------------------------------\n","    pdf_ = pd.DataFrame(plot_rows)\n","    fig, ax = plt.subplots(figsize=(6.5, 3))\n","    for k, (unit, col) in enumerate([(\"box\", \"#4C72B0\"), (\"track\", \"#DD8452\")]):\n","        d = pdf_[pdf_.unit == unit].set_index(\"arm\").reindex(arms)\n","        x = np.arange(len(arms)) + (k - 0.5) * 0.3\n","        ax.errorbar(x, d.qwk, yerr=[d.qwk - d.lo, d.hi - d.qwk], fmt=\"o\", color=col, capsize=3, label=f\"{unit} level\")\n","    ax.set_xticks(range(len(arms)), [ARM_NAMES.get(a, a) for a in arms], rotation=20, ha=\"right\")\n","    ax.set(ylabel=\"QWK [95% CI]\", title=\"Ordinal severity grading\"); ax.legend()\n","    save_fig(fig, \"fig_severity_qwk\", \"Severity grading performance (QWK, patient-cluster bootstrap 95% CI) of the traditional \"\n","             \"descriptor, the CNN and the hybrid arms, at box level and after aggregation along lesion tracks.\")\n","\n","    # ---- Figure: confusion matrices ---------------------------------------------------------------------------------\n","    best = max(arms, key=lambda a: SEV_SUMMARY[f\"box:{a}\"][\"QWK\"][0])\n","    show = list(OrderedDict.fromkeys([a for a in (\"desc_only\", \"cnn_raw\") if a in arms] + [best]))\n","    fig, ax = plt.subplots(1, len(show), figsize=(3.3 * len(show), 3.1), squeeze=False)\n","    for a_, arm in zip(ax[0], show):\n","        g = ens[ens.arm == arm]\n","        cm = pd.crosstab(g.level, np.clip(np.rint(g.p_exp), 0, 4).astype(int)).reindex(index=range(5), columns=range(5), fill_value=0)\n","        cmn = cm.div(cm.sum(1).replace(0, 1), axis=0)\n","        a_.imshow(cmn.values, cmap=\"Blues\", vmin=0, vmax=1)\n","        for i in range(5):\n","            for j_ in range(5):\n","                a_.text(j_, i, f\"{cmn.iat[i, j_]:.2f}\\n({cm.iat[i, j_]})\", ha=\"center\", va=\"center\", fontsize=6,\n","                        color=\"white\" if cmn.iat[i, j_] > 0.5 else \"black\")\n","        a_.set_xticks(range(5), LEVEL_NAMES, rotation=40, fontsize=7); a_.set_yticks(range(5), LEVEL_NAMES, fontsize=7)\n","        a_.set(xlabel=\"Predicted level\", ylabel=\"Annotated level\", title=f\"{ARM_NAMES.get(arm, arm)}\\nQWK={SEV_SUMMARY[f'box:{arm}']['QWK'][0]:.3f}\")\n","    save_fig(fig, \"fig_severity_confusion\", \"Row-normalised confusion matrices (counts in brackets) of box-level severity grading, \"\n","             \"seed-ensembled out-of-fold predictions. Most errors are between neighbouring levels.\")\n","\n","# ---- Track-linking sensitivity (Part C) ---------------------------------------------------------------------------\n","tsens = OUT / \"tables/partC_track_sensitivity.csv\"\n","if tsens.exists():\n","    save_table(pd.read_csv(tsens).round(3), \"tableS4_track_sensitivity\", \"Sensitivity of the track-level QWK (CNN (raw) + descriptor) \"\n","               \"to the track-linking distance limit (pre-registered value: 40 px).\")\n"]},{"cell_type":"code","execution_count":25,"id":"0dcf32c0","metadata":{"execution":{"iopub.execute_input":"2026-11-18T13:59:04.057935Z","iopub.status.busy":"2026-11-18T13:59:04.05731Z","iopub.status.idle":"2026-11-18T13:59:05.116009Z","shell.execute_reply":"2026-11-18T13:59:05.115359Z"},"papermill":{"duration":1.102023,"end_time":"2026-11-18T13:59:05.117454+00:00","exception":false,"start_time":"2026-11-18T13:59:04.015431+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Task</th>\n","      <th>Split</th>\n","      <th>Runs</th>\n","      <th>QWK</th>\n","      <th>MAE</th>\n","      <th>Accuracy ±1</th>\n","      <th>ΔQWK vs patient</th>\n","      <th>Relative</th>\