_lo\").iloc[-1]\n","H.append(dict(H=\"H2 (descriptor tracks grade)\", estimate=best_rho.spearman, ci=f\"[{best_rho.ci_lo:.3f}, {best_rho.ci_hi:.3f}]\",\n","              verdict=\"supported\" if best_rho.ci_lo > 0 else \"rejected\"))\n","for a, b in ([(\"cnn_raw+desc\", \"cnn_raw\"), (\"cnn_frangi\", \"cnn_raw\"), (\"cnn_frangi+desc\", \"cnn_raw\")] if len(sev_box) else []):\n","    x = sev_box[sev_box.arm == a].QWK.values - sev_box[sev_box.arm == b].QWK.values\n","    lo_a = sev_box[sev_box.arm == a].QWK_lo.mean(); hi_b = sev_box[sev_box.arm == b].QWK_hi.mean()\n","    H.append(dict(H=f\"H3 ({a} > {b}, QWK)\", estimate=float(np.mean(x)), ci=f\"seeds={len(x)}\",\n","                  verdict=\"supported\" if lo_a > hi_b else (\"trend\" if np.mean(x) > 0 else \"rejected\")))\n","g = cmp.loc[\"cnn_raw+desc\", \"gain\"] if len(cmp) and \"cnn_raw+desc\" in cmp.index else np.nan\n","H.append(dict(H=\"H4 (track aggregation > box-level)\", estimate=g, ci=\"see tables/partC\", verdict=\"trend\" if g > 0 else \"rejected\"))\n","if len(leak) and {\"frame_random\", \"patient_grouped\"} <= set(leak.regime):\n","    lr = leak.groupby(\"regime\").QWK.agg([\"mean\", \"std\"])\n","    gap = lr.loc[\"frame_random\", \"mean\"] - lr.loc[\"patient_grouped\", \"mean\"]\n","    H.append(dict(H=\"H6 (frame-random inflates vs patient split)\", estimate=gap, ci=f\"patient-split SD={lr.loc['patient_grouped', 'std']:.3f}\",\n","                  verdict=\"supported\" if gap > lr.loc[\"patient_grouped\", \"std\"] else \"rejected\"))\n","H = pd.DataFrame(H); H.to_csv(OUT / \"tables/hypotheses.csv\", index=False); display(H)\n","if FAST_DEV:\n","    print(\"FAST_DEV run: these verdicts are a pipeline check only and are NOT scientific results.\")\n","if not (DET_COMPLETE and SEV_COMPLETE and LEAK_COMPLETE):\n","    print(\"PARTIAL RESULTS - not all runs are finished. Attach this version's output and run the notebook again.\")"]},{"cell_type":"markdown","id":"255df88e","metadata":{"papermill":{"du