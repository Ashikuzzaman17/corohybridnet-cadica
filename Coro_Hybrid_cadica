 th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr>\n","      <th></th>\n","      <th colspan=\"3\" halign=\"left\">QWK</th>\n","      <th colspan=\"3\" halign=\"left\">MAE</th>\n","      <th colspan=\"3\" halign=\"left\">acc_pm1</th>\n","    </tr>\n","    <tr>\n","      <th></th>\n","      <th>mean</th>\n","      <th>std</th>\n","      <th>count</th>\n","      <th>mean</th>\n","      <th>std</th>\n","      <th>count</th>\n","      <th>mean</th>\n","      <th>std</th>\n","      <th>count</th>\n","    </tr>\n","    <tr>\n","      <th>regime</th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>frame_random</th>\n","      <td>0.955</td>\n","      <td>0.007</td>\n","      <td>15</td>\n","      <td>0.157</td>\n","      <td>0.020</td>\n","      <td>15</td>\n","      <td>0.982</td>\n","      <td>0.005</td>\n","      <td>15</td>\n","    </tr>\n","    <tr>\n","      <th>video_grouped</th>\n","      <td>0.750</td>\n","      <td>0.050</td>\n","      <td>11</td>\n","      <td>0.638</td>\n","      <td>0.082</td>\n","      <td>11</td>\n","      <td>0.857</td>\n","      <td>0.035</td>\n","      <td>11</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["                 QWK                 MAE              acc_pm1             \n","                mean    std count   mean    std count    mean    std count\n","regime                                                                    \n","frame_random   0.955  0.007    15  0.157  0.020    15   0.982  0.005    15\n","video_grouped  0.750  0.050    11  0.638  0.082    11   0.857  0.035    11"]},"metadata":{},"output_type":"display_data"}],"source":["def regime_folds(bx, regime, n, seed):\n","    idx = np.arange(len(bx))\n","    if regime == \"frame_random\":\n","        spl = KFold(n, shuffle=True, random_state=seed).split(idx)\n","    elif regime == \"video_grouped\":                  # shuffled: v1 used GroupKFold, which gives every seed the same split\n","        vids = np.random.default_rng(seed).permutation(bx.video.unique())\n","        vfold = {v: i % n for i, v in enumerate(vids)}\n","        fid = bx.video.map(vfold).values\n","        spl = [(idx[fid != k], idx[fid == k]) for k in range(n)]\n","    else:\n","        lv = bx.patient.map(bx.groupby(\"patient\")[\"level\"].max())\n","        spl = StratifiedGroupKFold(n, shuffle=True, random_state=seed).split(idx, lv.values, groups=bx.patient.values)\n","    grp = {\"frame_random\": np.arange(len(bx)), \"video_grouped\": bx.video.values}.get(regime, bx.patient.values)\n","    out = []\n","    for k, (tr, te) in enumerate(spl):\n","        rng = np.random.default_rng(seed + k)\n","        g_tr = rng.permutation(np.unique(grp[tr]))\n","        g_va = set(g_tr[:len(g_tr) // 6])\n","        is_va = np.array([g in g_va for g in grp[tr]])\n","        out.append((bx.iloc[tr[~is_va]], bx.iloc[tr[is_va]], bx.iloc[te]))   # val drawn in the same (leaky or not) way\n","    return out\n","\n","leak_file = OUT / \"tables/partD_leakage_severity.csv\"\n","nfold = 2 if FAST_DEV else CFG[\"n_outer_folds\"]\n","leak_folds = list(range(nfold)) if FAST_DEV else FOLDS_TO_RUN      # same session split as the other experiments\n","leak_runs = []\n","for regime in [\"frame_random\", \"video_grouped\", \"patient_grouped\"]:\n","    for seed in CFG[\"sev_seeds\"]:\n","        for k, (tr, va, te) in enumerate(regime_folds(sev_boxes.reset_index(drop=True), regime, nfold, seed)):\n","            f = OUT / \"sev_runs/leak\" / f\"{regime}_s{seed}_f{k}.json\"\n","            leak_runs.append(f)\n","            if f.exists() or k not in leak_folds or not budget_left(0.2):\n","                continue\n","            _, pt = train_severity(\"cnn_raw\", tr, va, te, seed, cs)\n","            f.write_text(json.dumps(dict(regime=regime, seed=seed, fold=k, **sev_metrics(te.level.values, pt)), default=float))\n","            print(f\"  leakage {regime} seed{seed} fold{k} done\", flush=True)\n","leak = pd.DataFrame([json.loads(f.read_text()) for f in leak_runs if f.exists()])\n","print(f\"leakage runs finished so far: {len(leak)} / {len(leak_runs)}\")\n","leak.to_csv(leak_file, index=False)\n","LEAK_COMPLETE = len(leak) == len(leak_runs)\n","if len(leak):\n","    display(leak.groupby(\"regime\")[[\"QWK\", \"MAE\", \"acc_pm1\"]].agg([\"mean\", \"std\", \"count\"]).round(3))"]},{"cell_type":"markdown","id":"ceb093b1","metadata":{"papermill":{"duration":0.029361,"end_time":"2026-10-26T04:26:13.832362+00:00","exception":false,"start_time":"2026-10-26T04:26:13.803001+00:00","status":"completed"},"tags":[]},"source":["## 12. Error analysis\n","Detection misses by grade and box size, using the pooled out-of-fold predictions of the best and the baseline variants."]},{"cell_type":"code","execution_count":17,"id":"85884307","metadata":{"execution":{"iopub.execute_input":"2026-10-26T04:26:13.894343Z","iopub.status.busy":"2026-10-26T04:26:13.893649Z","iopub.status.idle":"2026-10-26T04:26:22.137742Z","shell.execute_reply":"2026-10-26T04:26:22.136866Z"},"papermill":{"duration":8.277644,"end_time":"2026-10-26T04:26:22.139809+00:00","exception":false,"start_time":"2026-10-26T04:26:13.862165+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th>variant</th>\n","      <th>clahe</th>\n","      <th>frangi_early</th>\n","      <th>frangi_gated</th>\