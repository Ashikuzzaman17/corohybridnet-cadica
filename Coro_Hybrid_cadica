n","  </tbody>\n","</table>\n","</div>"],"text/plain":["variant    frangi_early  frangi_gated    raw     n\n","size_bin                                          \n","(0, 30]           0.017         0.046  0.017   959\n","(30, 45]          0.098         0.232  0.175  1141\n","(45, 70]          0.152         0.227  0.233   696\n","(70, 300]         0.003         0.014  0.041   293"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 900x300 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# ---- Detection: pooled out-of-fold matches (same matching rule as det_metrics) ---------------------------------\n","BX_BY_FRAME = boxes.groupby(\"frame\")\n","\n","def oof_matches(variant, seed):\n","    \"\"\"Out-of-fold test predictions of one variant/seed over all finished folds: per-prediction (score, tp) for the\n","    FROC/PR curves, and per-keyframe TP/FP counts at the fold's validation-chosen threshold.\"\"\"\n","    pr, fr_rows = [], []\n","    for fold in FOLDS:\n","        m = det_df[(det_df.variant == variant) & (det_df.fold == fold[\"fold\"]) & (det_df.seed == seed)]\n","        if m.empty:\n","            continue\n","        thr, preds = m.test_thr.iloc[0], load_preds(variant, seed, fold[\"fold\"])\n","        for r in det_frames[det_frames.patient.isin(fold[\"test\"])].itertuples():\n","            pos, ign = det_targets(BX_BY_FRAME.get_group(r.frame) if r.frame in BX_BY_FRAME.groups else boxes.iloc[:0], CFG[\"det_label_def\"])\n","            p = preds.get(r.frame, np.zeros((0, 5))); p = p[np.argsort(-p[:, 4])]\n","            o, n = match_image(p, pos, ign)\n","            pr += [(fold[\"fold\"], s, t) for s, t in o]\n","            hit = [t for s, t in o if s >= thr]\n","            fr_rows.append(dict(fold=fold[\"fold\"], seed=seed, patient=r.patient, video=r.video, frame=r.frame, n_gt=n,\n","                                tp=int(sum(hit)), fp=len(hit) - int(sum(hit)), score=float(p[:, 4].max()) if len(p) else 0.0))\n","    return pd.DataFrame(pr, columns=[\"fold\", \"score\", \"tp\"]), pd.DataFrame(fr_rows)\n","\n","def _f1(d):\n","    tp, fp, ng = d.tp.sum(), d.fp.sum(), d.n_gt.sum()\n","    return 2 * tp / max(2 * tp + fp + (ng - tp), 1)\n","def _sens(d):\n","    return d.tp.sum() / max(d.n_gt.sum(), 1)\n","def _prec(d):\n","    return d.tp.sum() / max(d.tp.sum() + d.fp.sum(), 1)\n","def _vauc(v):\n","    return roc_auc_score(v.label, v.score)\n","\n","DET_VARS = [v for v in CFG[\"det_variants\"] if len(det_df) and v in set(det_df.variant)]\n","DET_OOF = {(v, s): oof_matches(v, s) for v in DET_VARS for s in CFG[\"det_seeds\"] if ((det_df.variant == v) & (det_df.seed == s)).any()}\n","DET_SUMMARY = {}\n","if DET_VARS:\n","    rows = []\n","    for v in DET_VARS:\n","        runs = det_df[det_df.variant == v]\n","        fr = pd.concat([DET_OOF[v, s][1] for s in CFG[\"det_seeds\"] if (v, s) in DET_OOF], ignore_index=True)\n","        vv = fr.groupby([\"seed\", \"video\"]).agg(patient=(\"patient\", \"first\"), score=(\"score\", \"max\"),\n","                                                label=(\"n_gt\", lambda s: int(s.max() > 0))).reset_index()\n","        row = {\"Variant\": VAR_NAMES.get(v, v), \"Runs\": len(runs)}\n","        for col, name in [(\"test_AP50\", \"AP50\"), (\"test_F1\", \"F1\"), (\"test_P\", \"Precision\"), (\"test_R\", \"Sensitivity\"),\n","                          (\"test_sens@0.5FPpi\", \"Sens. @0.5 FP/img\"), (\"test_center_F1\", \"F1 (centre-hit)\"),\n","                          (\"test_iou03_F1\", \"F1 (IoU≥0.3)\"), (\"test_video_AUROC\", \"Video AUROC\")]:\n","            row[name] = msd_str(runs[col])\n","        DET_SUMMARY[v] = {}\n","        for fn, name, d in [(_f1, \"F1\", fr), (_sens, \"Sensitivity\", fr), (_prec, \"Precision\", fr), (_vauc, \"Video AUROC\", vv)]:\n","            est = patient_bootstrap(d, fn, CFG[\"n_boot\"])\n","            row[f\"Pooled {name} [95% CI]\"] = ci_str(*est); DET_SUMMARY[v][name] = [float(x) for x in est]\n","        DET_SUMMARY[v].update({c: float(runs[c].mean()) for c in [\"test_AP50\", \"test_F1\", \"test_video_AUROC\"]})\n","        rows.append(row)\n","    save_table(pd.DataFrame(rows), \"table2_detection\",\n","               f\"Stenosis detection (label definition {CFG['det_label_def']}: ≥50% positive, <50% ignored) under patient-level 5-fold CV. \"\n","               f\"Left: mean ± SD over fold×seed runs ({len(CFG['det_seeds'])} seeds); right: out-of-fold predictions pooled over folds and \"\n","               f\"seeds at each fold's validation-chosen threshold, with patient-cluster bootstrap 95% CIs ({CFG['n_boot']} resamples). \"\n","               f\"Detector: Faster R-CNN {CFG['det_arch']} @ {CFG['det_size']} px.\")\n","    KEY[\"detection\"] = DET_SUMMARY\n","\n","    if len(partA):\n","        t3 = []\n","        for r in partA.itertuples():\n","            m_, lo, hi = ci_of_diff(det_df, r.variant, \"raw\", r.metric)\n","            t3.append({\"Comparison\": f\"{VAR_NAMES.get(r.variant, r.variant)} − Raw\", \"Metric\": r.metric.replace(\"test_\", \"\"), \"Pairs\": r.n_pairs,\n","                       \"Mean difference [95% CI]\": ci_str(m_, lo, hi, 4) if not np.isnan(lo) else f\"{m_:.4f}\",\n","                       \"Wilcoxon p\": f\"{r.p:.3f}\" if pd.notna(r.p) else \"n<6\", \"Holm p\": f\"{getattr(r, 'p_holm', np.nan):.3f}\"\n","                       if pd.notna(getattr(r, \"p_holm\", np.nan)) else \"–\"})\n","        save_table(pd.DataFrame(t3), \"table3_detection_paired\",\n","                   \"Paired comparison of each hybrid detector with the raw baseline on identical folds and seeds. CI: bootstrap over \"\n","                   \"fold×seed pairs; p: Wilcoxon signed-rank, Holm-corrected across hybrids within each metric.\")\n","        KEY[\"detection_paired\"] = partA.round(4).to_dict(\"records\")\n","\n","    # ---- Figure: per-run results (paired) -------------------------------------------------------------------------\n","    fig, ax = plt.subplots(1, 3, figsize=(10.5, 3))\n","    for a, (col, name) in zip(ax, [(\"test_AP50\", \"AP50\"), (\"test_F1\", \"F1 at validation threshold\"), (\"test_video_AUROC\", \"Video AUROC\")]):\n","        wide = det_df.pivot_table(index=[\"fold\", \"seed\"], columns=\"variant\", values=col).reindex(columns=DET_VARS)\n","        for _, r in wide.iterrows():\n","            a.plot(range(len(DET_VARS)), r.values, color=\"0.82\", lw=0.7, zorder=1)\n","        for i, v in enumerate(DET_VARS):\n","            a.scatter(np.full(len(wide), i), wide[v], s=12, color=COLORS.get(v), zorder=2)\n","            a.errorbar(i + 0.2, wide[v].mean(), yerr=wide[v].std(), fmt=\"o\", color=\"k\", ms=4, capsize=3, zorder=3)\n","        a.set_xticks(range(len(DET_VARS)), [VAR_NAMES.get(v, v) for v in DET_VARS], rotation=20); a.set_title(name)\n","    save_fig(fig, \"fig_detection_runs\", \"Detection results of every patient-level CV run (dots; grey lines join runs on the same fold \"\n","             \"and seed, so the comparison is paired). Black: mean ± SD.\")\n","\n","    # ---- Figure: FROC and precision-recall, pooled out-of-fold (first seed) -----------------------------------------\n","    s0 = CFG[\"det_seeds\"][0]\n","    fig, ax = plt.subplots(1, 2, figsize=(8.5, 3.2))\n","    for v in DET_VARS:\n","        if (v, s0) not in DET_OOF:\n","            continue\n","        pr, fr = DET_OOF[v, s0]\n","        pr = pr.sort_values(\"score\", ascending=False)\n","        ctp, cfp = pr.tp.cumsum().values, (1 - pr.tp).cumsum().values\n","        ax[0].plot(cfp / len(fr), ctp / max(fr.n_gt.sum(), 1), color=COLORS.get(v), label=VAR_NAMES.get(v, v))\n","        ax[1].plot(ctp / max(fr.n_gt.sum(), 1), ctp / np.maximum(ctp + cfp, 1), color=COLORS.get(v), label=VAR_NAMES.get(v, v))\n","    ax[0].set(xscale=\"log\", xlim=(0.01, 5), ylim=(0, 1), xlabel=\"False positives per keyframe\", ylabel=\"Sensitivity\", title=\"(a) FROC\")\n","    for x_ in (0.25, 0.5, 1.0):\n","        ax[0].axvline(x_, color=\"0.85\", lw=0.8, zorder=0)\n","    ax[1].set(xlim=(0, 1), ylim=(0, 1), xlabel=\"Recall\", ylabel=\"Precision\", title=\"(b) Precision–recall (IoU ≥ 0.5)\")\n","    ax[1].legend()\n","    save_fig(fig, \"fig_detection_froc_pr\", f\"FROC (a) and precision–recall (b) curves of the pooled out-of-fold test predictions \"\n","             f\"(patient-level CV, seed {s0}). Vertical lines: the 0.25/0.5/1 FP-per-image operating points of Table 2.\")\n","\n","    # ---- Figure: validation curves --------------------------------------------------------------------------------\n","    hist = []\n","    for r in det_df.itertuples():\n","        hf = OUT / \"det_runs\" / f\"{r.variant}_{r.label_def}_{DET_ID}_s{r.seed}_f{r.fold}\" / \"history.csv\"\n","        if hf.exists():\n","            hist.append(pd.read_csv(hf).assign(variant=r.variant, fold=r.fold, seed=r.seed))\n","    if hist:\n","        hist = pd.concat(hist)\n","        fig, ax = plt.subplots(1, 2, figsize=(8.5, 3))\n","        for v, g in hist.groupby(\"variant\"):\n","            agg = g.groupby(\"epoch\")[[\"loss\", \"val_AP50\"]].agg([\"mean\", \"std\"])\n","            for a, c in zip(ax, [\"loss\", \"val_AP50\"]):\n","                a.plot(agg.index + 1, agg[c][\"mean\"], color=COLORS.get(v), label=VAR_NAMES.get(v, v))\n","                a.fill_between(agg.index + 1, agg[c][\"mean\"] - agg[c][\"std\"].fillna(0), agg[c][\"mean\"] + agg[c][\"std\"].fillna(0),\n","                               color=COLORS.get(v), alpha=0.15)\n","        ax[0].set(xlabel=\"Epoch\", ylabel=\"Training loss\", title=\"(a) Training loss\"); ax[1].set(xlabel=\"Epoch\", ylabel=\"AP50\", title=\"(b) Validation AP50 (held-out patients)\")\n","        ax[1].legend()\n","        save_fig(fig, \"figS_detection_training\", \"Detector training loss and validation-patient AP50 per epoch (mean ± SD over runs). \"\n","                 \"Validation AP peaks early, so the checkpoint is chosen on validation patients.\")\n","\n","    # ---- Figure: qualitative examples -----------------------------------------------------------------------------\n","    hybrids = [v for v in DET_VARS if v != \"raw\"]\n","    if \"raw\" in DET_VARS and hybrids and ((\"raw\", s0) in DET_OOF):\n","        hv = max(hybrids, key=lambda v: DET_SUMMARY[v][\"test_F1\"])\n","        if (hv, s0) in DET_OOF:\n","            a_, b_ = DET_OOF[\"raw\", s0][1], DET_OOF[hv, s0][1]\n","            j = a_.merge(b_[[\"frame\", \"tp\", \"fp\"]], on=\"frame\", suffixes=(\"_raw\", \"_hyb\"))\n","            j = j[j.n_gt > 0].sample(frac=1, random_state=0)\n","            pick = (list(j[(j.tp_hyb > j.tp_raw)].frame[:2]) + list(j[(j.tp_hyb > 0) & (j.tp_raw > 0)].frame[:1]) +\n","                    list(j[(j.tp_hyb == 0) & (j.tp_raw == 0)].frame[:1]))\n","            if pick:\n","                fold_of = j.set_index(\"frame\").fold\n","                fig, ax = plt.subplots(3, len(pick), figsize=(2.6 * len(pick), 7.8), squeeze=False)\n","                for c, fr in enumerate(pick):\n","                    k = int(fold_of[fr]); img = store.img[fr]\n","                    pos, _ = det_targets(BX_BY_FRAME.get_group(fr), CFG[\"det_label_def\"])\n","                    for rr, (v, bg) in enumerate([(\"raw\", img), (hv, img), (None, store.ves[fr])]):\n","                        a = ax[rr, c]; a.imshow(bg, cmap=\"gray\"); a.set_xticks([]); a.set_yticks([])\n","                        for sp in a.spines.values():\n","                            sp.set_visible(False)\n","                        for b in pos:\n","                            a.add_patch(plt.Rectangle(b[:2], b[2] - b[0], b[3] - b[1], fill=False, ec=\"#55A868\", lw=1.5))\n","                        if v is None:\n","                            continue\n","                        thr = det_df[(det_df.variant == v) & (det_df.fold == k) & (det_df.seed == s0)].test_thr.iloc[0]\n","                        p = load_preds(v, s0, k).get(fr, np.zeros((0, 5)))\n","                        for b in p[p[:, 4] >= thr]:\n","                            a.add_patch(plt.Rectangle(b[:2], b[2] - b[0], b[3] - b[1], fill=False, ec=COLORS.get(v), lw=1.2, ls=\"--\"))\n","                            a.text(b[0], b[1] - 3, f\"{b[4]:.2f}\", color=COLORS.get(v), fontsize=6)\n","                    ax[0, c].set_title(fr, fontsize=7)\n","                for rr, t in enumerate([VAR_NAMES[\"raw\"], VAR_NAMES.get(hv, hv), \"Frangi vesselness\"]):\n","                    ax[rr, 0].set_ylabel(t)\n","                save_fig(fig, \"fig_detection_examples\", f\"Test-patient keyframes (out-of-fold). Green: ground-truth stenoses ≥50%; dashed: \"\n","                         f\"detections above the validation-chosen threshold (score shown) for the raw detector (top) and the best hybrid, \"\n","                         f\"{VAR_NAMES.get(hv, hv)} (middle); bottom: the Frangi vesselness input. Columns 1–2: found only by the hybrid; \"\n","                         f\"3: found by both; 4: missed by both.\")\n","\n","# ---- Error analysis: sensitivity by grade and lesion size -------------------------------------------------------\n","if len(err):\n","    by_grade = err.pivot_table(index=\"grade\", columns=\"variant\", values=\"hit\", aggfunc=\"mean\").reindex([g for g in GRADES if g in set(err.grade)])\n","    by_size = err.pivot_table(index=\"size_bin\", columns=\"variant\", values=\"hit\", aggfunc=\"mean\", observed=False)\n","    n_grade, n_size = err[err.variant == err.variant.iloc[0]].groupby(\"grade\").size(), err[err.variant == err.variant.iloc[0]].groupby(\"size_bin\", observed=False).size()\n","    save_table(by_grade.assign(n=n_grade).round(3), \"tableS2_sensitivity_by_grade\", \"Detection sensitivity (IoU ≥ 0.5, validation-chosen \"\n","               f\"threshold, seed {CFG['det_seeds'][0]}, pooled out-of-fold) by annotated grade.\", index=True)\n","    save_table(by_size.assign(n=n_size).round(3), \"tableS3_sensitivity_by_size\", \"Detection sensitivity by lesion size √(w·h) in px.\", index=True)\n","    fig, ax = plt.subplots(1, 2, figsize=(9, 3))\n","    for a, tab, xl in [(ax[0], by_grade, \"Annotated grade\"), (ax[1], by_size, \"Lesion size √(w·h), px\")]:\n","        w = 0.8 / max(tab.shape[1], 1)\n","        for i, v in enumerate(tab.columns):\n","            a.bar(np.arange(len(tab)) + i * w - 0.4 + w / 2, tab[v].values, w, color=COLORS.get(v), label=VAR_NAMES.get(v, v))\n","        a.set_xticks(range(len(tab)), [str(x) for x in tab.index], rotation=20); a.set(xlabel=xl, ylabel=\"Sensitivity\", ylim=(0, 1))\n","    ax[0].legend(); ax[0].set_title(\"(a) By grade\"); ax[1].set_title(\"(b) By size\")\n","    save_fig(fig, \"fig_error_analysis\", \"Error analysis: detection sensitivity of ≥50% stenoses by annotated grade (a) and lesion size (b).\")\n"]},{"cell_type":"code","execution_count":24,"id":"3cb777eb","metadata":{"execution":{"iopub.execute_input":"2026-11-08T21:58:51.567853Z","iopub.status.busy":"2026-11-08T21:58:51.567514Z","iopub.status.idle":"2026-11-08T22:00:32.144375Z","shell.execute_reply":"2026-11-08T22:00:32.143473Z"},"papermill":{"duration":100.613711,"end_time":"2026-11-08T22:00:32.146079+00:00","exception":false,"start_time":"2026-11-08T21:58:51.532368+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Unit</th>\n","      <th>Arm</th>\n","      <th>n</th>\n","      <th>QWK [95% CI]</th>\n","      <th>QWK per seed</th>\n","      <th>MAE</th>\n","      <th>Accuracy</th>\n","      <th>Accuracy ±1</th>\n","      <th>AUROC ≥70%</th>\n","    </tr>\n","  </the