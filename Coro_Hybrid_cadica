 > 0 else (\"rejected\" if not np.isnan(lo) else \"insufficient runs\")))\n","best_rho = pilot[pilot.subset == \"all grades\"].sort_values(\"ci_lo\").iloc[-1]\n","H.append(dict(H=\"H2 (descriptor tracks grade)\", estimate=best_rho.spearman, ci=f\"[{best_rho.ci_lo:.3f}, {best_rho.ci_hi:.3f}]\",\n","              verdict=\"supported\" if best_rho.ci_lo > 0 else \"rejected\"))\n","if len(sev_oof) and \"cnn_raw\" in set(sev_oof.arm):\n","    ens_h = sev_oof.groupby([\"arm\", \"uid\"]).agg(patient=(\"patient\", \"first\"), level=(\"level\", \"first\"), p_exp=(\"p_exp\", \"mean\")).reset_index()\n","    base_h = ens_h[ens_h.arm == \"cnn_raw\"]\n","    for a in [a for a in (\"cnn_raw+desc\", \"cnn_frangi\", \"cnn_frangi+desc\", \"cnn_sharp\", \"corohybrid\", \"corohybrid+desc\") if a in set(ens_h.arm)]:\n","        d_ = ens_h[ens_h.arm == a].merge(base_h[[\"uid\", \"p_exp\"]], on=\"uid\", suffixes=(\"\", \"_base\"))\n","        est, lo, hi = patient_bootstrap(d_, lambda x: _qwk_h(x.level.values, x.p_exp.values) - _qwk_h(x.level.values, x.p_exp_base.values), CFG[\"n_boot\"])\n","        H.append(dict(H=f\"H3 ({a} > cnn_raw, QWK)\", estimate=float(est), ci=f\"[{lo:.3f}, {hi:.3f}]\",\n","                      verdict=\"supported\" if lo > 0 else (\"trend\" if est > 0 else \"rejected\")))\n","g = cmp.loc[\"corohybrid+desc\" if (len(cmp) and \"corohybrid+desc\" in cmp.index) else \"cnn_raw+desc\", \"gain\"] if len(cmp) and ({\"corohybrid+desc\", \"cnn_raw+desc\"} & set(cmp.index)) else np.nan\n","H.append(dict(H=\"H4 (track aggregation > box-level)\", estimate=g, ci=\"see tables/partC\", verdict=\"trend\" if g > 0 else \"rejected\"))\n","if len(leak) and {\"frame_random\", \"patient_grouped\"} <= set(leak.regime):\n","    lr = leak.groupby(\"regime\").QWK.agg([\"mean\", \"std\"])\n","    gap = lr.loc[\"frame_random\", \"mean\"] - lr.loc[\"patient_grouped\", \"mean\"]\n","    H.append(dict(H=\"H5 (frame-random inflates severity QWK vs patient split)\", estimate=gap, ci=f\"patient-split SD={lr.loc['patient_grouped', 'std']:.3f}\",\n","                  verdict=\"supported\" if gap > lr.loc[\"patient_grouped\", \"std\"] else \"rejected\"))\n","if FAST_DEV:\n","    print(\"FAST_DEV run: these verdicts are a pipeline check only and are NOT scientific results.\")\n","if len(det_leak) and {\"frame_random\", \"patient_grouped\"} <= set(det_leak.regime):\n","    dl_ = det_leak.groupby(\"regime\").test_AP50.agg([\"mean\", \"std\"])\n","    gap = dl_.loc[\"frame_random\", \"mean\"] - dl_.loc[\"patient_grouped\", \"mean\"]\n","    H.append(dict(H=\"H6 (frame-random inflates detection AP50 vs patient split)\", estimate=gap,\n","                  ci=f\"patient-split SD={dl_.loc['patient_grouped', 'std']:.3f}\",\n","                  verdict=\"supported\" if gap > dl_.loc[\"patient_grouped\", \"std\"] else \"rejected\"))\n","H = pd.DataFrame(H); H.to_csv(OUT / \"tables/hypotheses.csv\", index=False); display(H)\n","if not (DET_COMPLETE and SEV_COMPLETE and LEAK_COMPLETE and DET_LEAK_COMPLETE):\n","    print(\"PARTIAL RESULTS - not all runs are finished. Attach this version's output and run the notebook again.\")"]},{"cell_type":"markdown","id":"0fa42065","metadata":{"papermill":{"duration":0.028728,"end_time":"2026-11-18T13:53:53.337206+00:00","exception":false,"start_time":"2026-11-18T13:53:53.308478+00:00","status":"completed"},"tags":[]},"source":["## 16. Paper figures and tables\n","\n","Built only from saved results, so this section also works on partial results and can be re-run on its own. Outputs go to `OUT/paper/`: `figures/` (PNG 300 dpi + PDF), `tables/` (CSV + LaTeX), `captions.md` (draft caption for every item), `key_numbers.json` (every number quoted in the text) and `paper_bundle.zip` (all of it, for download). `captions.md` starts with **COMPLETE** or **PARTIAL RESULTS**: write final numbers only from a COMPLETE run.\n","\n","| Item | Paper section |\n","|---|---|\n","| Table 1a–c, Table S1 | Data: dataset, grades, patient characteristic