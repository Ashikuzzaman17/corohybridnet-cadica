)\n","eff.append({\"Model\": \"Severity: ResNet-18 ordinal (+ descriptor)\", \"Parameters (M)\": round(sum(p.numel() for p in sm.parameters()) / 1e6, 2),\n","            \"Inference, ms/frame\": round(sev_ms, 1), \"  of which Frangi, ms\": 0.0, \"Training, min/run\": np.nan})\n","eff.append({\"Model\": \"Narrowing descriptor (CPU, 1 core, per box)\", \"Parameters (M)\": 0.0, \"Inference, ms/frame\": round(desc_ms, 1),\n","            \"  of which Frangi, ms\": round(desc_ms, 1), \"Training, min/run\": 0.0})\n","del sm; torch.cuda.empty_cache()\n","gpu_name = torch.cuda.get_device_name(0) if DEVICE.type == \"cuda\" else \"CPU\"\n","save_table(pd.DataFrame(eff), \"table9_compute\", f\"Model size and compute cost on {gpu_name} (batch 1, mixed precision; detector \"\n","           f\"input {CFG['det_size']} px). Frangi-based detectors include the GPU vesselness map ({len(CFG['frangi_sigmas_full'])} scales). \"\n","           \"Severity inference is per box crop.\")\n","KEY[\"compute\"] = dict(gpu=gpu_name, rows=eff)\n","\n","# ---- Export: key numbers, captions, one zip to download ---------------------------------------------------------------\n","KEY[\"settings\"] = dict(det_arch=CFG[\"det_arch\"], det_size=CFG[\"det_size\"], det_epochs=CFG[\"det_epochs\"], det_seeds=CFG[\"det_seeds\"],\n","                       det_variants=CFG[\"det_variants\"], label_def=CFG[\"det_label_def\"], sev_seeds=CFG[\"sev_seeds\"],\n","                       sev_epochs=CFG[\"sev_epochs\"], n_folds=CFG[\"n_outer_folds\"], n_boot=CFG[\"n_boot\"], env=env)\n","(PAPER / \"key_numbers.json\").write_text(json.dumps(KEY, indent=2, default=float), encoding=\"utf-8\")\n","status = (\"COMPLETE\" if all(v for k, v in KEY[\"complete\"].items() if k != \"fast_dev\") and not FAST_DEV else\n","          \"PARTIAL RESULTS - do not write final numbers from this version\")\n","lines = [f\"# Paper figures and tables ({status})\", \"\",\n","         \"PNG (300 dpi) + PDF for every figure; CSV + LaTeX for eve