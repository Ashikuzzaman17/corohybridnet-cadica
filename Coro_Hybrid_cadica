m - r) * pvals[i]); adj[i] = min(1, run)\n","    return adj\n","\n","def paired_vs(df, baseline, metric, key=(\"fold\", \"seed\")):\n","    rows = []\n","    base = df[df.variant == baseline].set_index(list(key))[metric]\n","    for v in df.variant.unique():\n","        if v == baseline:\n","            continue\n","        d = (df[df.variant == v].set_index(list(key))[metric] - base).dropna()\n","        p = wilcoxon(d).pvalue if len(d) >= 6 and np.any(d != 0) else np.nan\n","        rows.append(dict(variant=v, metric=metric, n_pairs=len(d), mean_diff=d.mean(), sd_diff=d.std(), p=p))\n","    out = pd.DataFrame(rows)\n","    if out.p.notna().any():\n","        out.loc[out.p.notna(), \"p_holm\"] = holm(out.p.dropna().values)\n","    return out\n","\n","if len(det_df) and \"raw\" in set(det_df.variant):\n","    partA = pd.concat([paired_vs(det_df, \"raw\", m) for m in [\"test_AP50\", \"test_F1\", \"test_center_F1\", \"test_video_AUROC\"]])\n","    partA.to_csv(OUT / \"tables/partA_paired_vs_raw.csv\", index=False); display(partA.round(4))\n","else:\n","    partA = pd.DataFrame(); print(\"no detector runs yet - Part A statistics skipped\")"]},{"cell_type":"markdown","id":"1d226d3c","metadata":{"papermill":{"duration":0.025494,"end_time":"2026-10-26T03:02:12.365023+00:00","exception":false,"start_time":"2026-10-26T03:02:12.339529+00:00","status":"completed"},"tags":[]},"source":["## 9. Part B: ordinal severity grading (CNN + Frangi descriptor fusion)\n","\n","Task: given a lesion box, predict its 5-level grade (<20, 20–50, 50–70, 70–90, ≥90%). Ground-truth boxes are used, so severity is measured separately from detection quality. Five arms on identical folds:\n","\n","| Arm | Input |\n","|---|---|\n","| `desc_only` | descriptor vector only (cumulative-logit ordinal model) — pure traditional CV |\n","| `cnn_raw` | ResNet-18 on the box crop [I,I,I] |\n","| `cnn_frangi` | ResNet-18 on [I,V,I] (early hybrid) |\n","| `cnn_raw+desc` | `cnn_raw` + descriptor fused before the ordinal head (**late hybrid**) |\n","| `cnn_frangi+desc` | both |\n","\n","Ordinal head: K−1 = 4 cumulative logits `P(y > k)` trained with BCE (CORAL-style). Metrics: quadratic-weighted κ (primary), MAE, ±1-level accuracy, and AUROC for ≥70%."]},{"cell_type":"code","execution_count":14,"id":"29e65283","metadata":{"execution":{"iopub.execute_input":"2026-10-26T03:02:12.416574Z","iopub.status.busy":"2026-10-26T03:02:12.416353Z","iopub.status.idle":"2026-10-26T03:59:31.341262Z","shell.execute_reply":"2026-10-26T03:59:31.340231Z"},"papermill":{"duration":3438.986732,"end_time":"2026-10-26T03:59:31.37696+00:00","exception":false,"start_time":"2026-10-26T03:02:12.390228+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Frangi cache (cuda): computed 0 maps in 0s (3996 total)\n","CropStore: 6161 crops in 30s\n","  patientCV fold0 seed0 desc_only: QWK=0.405\n","Downloading: \"https://download.pytorch.org/models/resnet18-f37072fd.pth\" to /root/.cache/torch/hub/checkpoints/resnet18-f37072fd.pth\n"]},{"name":"stderr","output_type":"stream","text":["100%|██████████| 44.7M/44.7M [00:00<00:00, 174MB/s]\n"]},{"name":"stdout","output_type":"stream","text":["  patientCV fold0 seed0 cnn_raw: QWK=0.671\n","  patientCV fold0 seed0 cnn_frangi: QWK=0.524\n","  patientCV fold0 seed0 cnn_raw+desc: QWK=0.569\n","  patientCV fold0 seed0 cnn_frangi+desc: QWK=0.624\n","  patientCV fold0 seed1 desc_only: QWK=0.405\n","  patientCV fold0 seed1 cnn_raw: QWK=0.686\n","  patientCV fold0 seed1 cnn_frangi: QWK=0.539\n","  patientCV fold0 seed1 cnn_raw+desc: QWK=0.621\n","  patientCV fold0 seed1 cnn_frangi+desc: QWK=0.495\n","  patientCV fold0 seed2 desc_only: QWK=0.405\n","  patientCV fold0 seed2 cnn_raw: QWK=0.651\n","  patientCV fold0 seed2 cnn_frangi: QWK=0.560\n","  patientCV fold0 seed2 cnn_raw+desc: QWK=0.640\n","  patientCV fold0 seed2 cnn_frangi+desc: QWK=0.593\n","  patientCV fold1 seed0 desc_only: QWK=0.575\n","  patientCV fold1 seed0 cnn_raw: