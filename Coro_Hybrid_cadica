4  0.157     0.083\n","(70, 300]  0.020         0.014         0.000  0.020     0.007"]},"metadata":{},"output_type":"display_data"}],"source":["def load_preds(variant, seed, fold):\n","    f = OUT / \"det_runs\" / f\"{variant}_{CFG['det_label_def']}_{DET_ID}_s{seed}_f{fold}\" / \"test_preds.csv\"\n","    cols = [\"frame\", \"x1\", \"y1\", \"x2\", \"y2\", \"score\"]\n","    p = pd.read_csv(f) if f.exists() and f.stat().st_size > 2 else pd.DataFrame(columns=cols)\n","    return {fr: g[[\"x1\", \"y1\", \"x2\", \"y2\", \"score\"]].values for fr, g in p.groupby(\"frame\")}\n","\n","err = []\n","for variant in (CFG[\"det_variants\"] if len(det_df) else []):\n","    for fold in FOLDS:                               # every fold with a finished run (any session)\n","        seed = CFG[\"det_seeds\"][0]\n","        m = det_df[(det_df.variant == variant) & (det_df.fold == fold[\"fold\"]) & (det_df.seed == seed)]\n","        if m.empty:\n","            continue\n","        thr, preds = m.test_thr.iloc[0], load_preds(variant, seed, fold[\"fold\"])\n","        tb = boxes[boxes.patient.isin(fold[\"test\"]) & boxes.frame.isin(det_frames.frame) & (boxes.level >= 2)]\n","        for r in tb.itertuples():\n","            p = preds.get(r.frame, np.zeros((0, 5))); p = p[p[:, 4] >= thr]\n","            hit = len(p) > 0 and box_iou_np(np.array([r.x, r.y, r.x + r.w, r.y + r.h]), p[:, :4]).max() >= 0.5\n","            err.append(dict(variant=variant, grade=r.grade, size=np.sqrt(r.w * r.h), hit=hit))\n","err = pd.DataFrame(err)\n","if len(err):\n","    err[\"size_bin\"] = pd.cut(err[\"size\"], [0, 30, 45, 70, 300])\n","    display(err.pivot_table(index=\"grade\", columns=\"variant\", values=\"hit\", aggfunc=\"mean\").reindex(GRADES).round(3))\n","    display(err.pivot_table(index=\"size_bin\", columns=\"variant\", values=\"hit\", aggfunc=\"mean\", observed=False).round(3))\n","    err.to_csv(OUT / \"tables/error_analysis_detection.csv\", index=False)"]},{"cell_type":"markdown","id":"6b6c6418","metadata":{"papermill":{"duration":0.032908,"end_time":"2026-10-26T04:26:22.206607+00:00","exception":false,"start_time":"2026-10-26T04:26:22.173699+00:00","status":"completed"},"tags":[]},"source":["## 13. External validation (ARCADE stenosis set) — runs only if data is present\n","\n","ARCADE (Popov et al., *Sci Data* 2024) labels stenoses ≥50% only, which matches label definition **L2**. Models are trained on **all** CADICA patients using the median best epoch from cross-validation, then evaluated zero-shot. Expected layout: `ARCADE_ROOT/stenosis/test/images/*.png` and `ARCADE_ROOT/stenosis/test/annotations/*.json` (COCO). **Check your download** and adjust the two glob patterns if needed.\n","\n","AngioCAD (Zenodo 15826856, 413 patients, artery-level 7-category labels) is the planned second external set. Its label format must be verified after download before writing an evaluation, so it is not implemented here."]},{"cell_type":"code","execution_count":18,"id":"b20da401","metadata":{"execution":{"iopub.execute_input":"2026-10-26T04:26:22.27703Z","iopub.status.busy":"2026-10-26T04:26:22.276402Z","iopub.status.idle":"2026-10-26T04:26:22.289538Z","shell.execute_reply":"2026-10-26T04:26:22.288579Z"},"papermill":{"duration":0.05024,"end_time":"2026-10-26T04:26:22.291259+00:00","exception":false,"start_time":"2026-10-26T04:26:22.241019+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["ARCADE external validation skipped (needs: ARCADE data, all detector runs finished, >=3 h budget left, not FAST_DEV).\n"]}],"source":["arc_imgs = sorted(glob.glob(str(ARCADE_ROOT / \"stenosis\" / \"test\" / \"images\" / \"*.png\")))\n","arc_json = sorted(glob.glob(str(ARCADE_ROOT / \"stenosis\" / \"test\" / \"annotations\" / \"*.json\")))\n","if arc_imgs and arc_json and not FAST_DEV and DET_COMPLETE and budget_left(3.0):\n","    coco = json.loads(Path(arc_json[0]).read_text())\n","    id2file = {im[\"id\"]: im[\"file_name\"] for im in coco[\"images\"]}\n","    arc_t = {Path(f).stem: (np.zeros((0, 4)), np.zeros((0, 4))) for f in id2file.values()}\n","    for a in coco[\"annotations\"]:\n","        st = Path(id2file[a[\"image_id\"]]).stem; x, y, w, h = a[\"bbox\"]\n","        arc_t[st] = (np.vstack([arc_t[st][0], [x, y, x + w, y + h]]), arc_t[st][1])\n","    arc_frames = pd.DataFrame(dict(frame=list(arc_t), video=list(arc_t), patient=list(arc_t),\n","                                   path=[str(Path(arc_imgs[0]).parent / f\"{s}.png\") for s in arc_t]))\n","    build_frangi_cache(arc_frames)\n","    store_all = store if len(store.img) == len(frames) else FrameStore(frames)\n","    arc_store = FrameStore(arc_frames, temporal=False)   # ARCADE has single frames: temporal uses the frame itself\n","    ext = []\n","    for variant in CFG[\"det_variants\"]:\n","        ep = int(det_df[det_df.variant == variant].best_epoch.median()) + 1\n","        all_fold = dict(fold=\"ALL\", train=sorted(frames.patient.unique()), val=FOLDS[0][\"val\"], test=FOLDS[0][\"test\"])\n","        saved_epochs = CFG[\"det_epochs\"]; CFG[\"det_epochs\"] = ep; CFG[\"save_weights\"] = True\n","        train_detector(variant, all_fold, 0, store_all)\n","        CFG[\"det_epochs\"] = saved_epochs; CFG[\"save_weights\"] = False\n","        model = build_detector(CFG[\"det_arch\"], variant).to(DEVICE)\n","        model.load_state_dict(torch.load(OUT / \"det_runs\" / f\"{variant}_{CFG['det_label_def']}_{DET_ID}_s0_fALL\" / \"weights.pt\"))\n","        ds = DetDataset(arc_frames, boxes.iloc[:0], arc_store, variant, \"L2\", False); ds.t = arc_t\n","        thr = det_df[det_df.variant == variant].test_thr.median()\n","        ext.append(dict(variant=variant, **det_metrics(predict(model, ds), arc_t, arc_frames, thr=thr)))\n","    ext = pd.DataFrame(ext); ext.to_csv(OUT / \"tables/external_arcade.csv\", index=False); display(ext.round(3))\n","else:\n","    print(\"ARCADE external validation skipped (needs: ARCADE data, all detector runs finished, >=3 h budget left, not FAST_DEV).\")"]},{"cell_type":"markdown","id":"e7846e7b","metadata":{"papermill":{"duration":0.030668,"end_time":"2026-10-26T04:26:22.351423+00:00","exception":false,"start_time":"2026-10-26T04:26:22.320755+00:00","status":"completed"},"tags":[]},"source":["## 14. Hypothesis check (automatic, using the pre-registered rules)"]},{"cell_type":"code","execution_count":19,"id":"c7b43842","metadata":{"execution":{"iopub.execute_input":"2026-10-26T04:26:22.412592Z","iopub.status.busy":"2026-10-26T04:26:22.41234Z","iopub.status.idle":"2026-10-26T04:26:23.272608Z","shell.execute_reply":"2026-10-26T04:26:23.27168Z"},"papermill":{"duration":0.893342,"end_time":"2026-10-26T04:26:23.274325+00:00","exception":false,"start_time":"2026-10-26T04:26:22.380983+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>H</th>\n","      <th>estimate</th>\n","      <th>ci</th>\n","      <th>verdict</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>H1 (frangi_early &gt; raw, detection F1)</td>\n","      <td>-0.048276</td>\n","      <td>[-0.077, -0.020]</td>\n","      <td>rejected</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>H1 (frangi_early &gt; raw, detection AP50)</td>\n","      <td>-0.031962</td>\n","      <td>[-0.051, -0.013]</td>\n","      <td>rejected</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>H1 (frangi_gated &gt; raw, detection F1)</td>\n","      <td>-0.000493</td>\n","      <td>[-0.025, 0.026]</td>\n","      <td>rejected</td>\n","