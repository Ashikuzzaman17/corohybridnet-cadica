Centre shift (median {audit['shift'].median():.1f} px)\")\n","ax[2].bar(LEVEL_NAMES, flip_by_level.values, color=\"#DD8452\")\n","ax[2].set(ylabel=\"Tracks with >1 grade\", title=\"(c) Grade changes along a track\"); ax[2].tick_params(axis=\"x\", rotation=30)\n","save_fig(fig, \"fig_annotation_audit\", \"Annotation audit of CADICA. (a) IoU and (b) centre shift between the boxes of a single lesion in \"\n","         \"consecutive keyframes (single-box frames only), which bound IoU-based scoring. (c) Fraction of lesion tracks (≥2 boxes) whose \"\n","         \"annotated grade changes along the track, by the track's modal level.\")\n","KEY[\"audit\"] = {k: float(v) for k, v in summary_audit.items()}\n","KEY[\"audit\"][\"tracks_multi_grade_frac\"] = float((trk.n_grades > 1).mean())\n","\n","# ---- Figure: how the relative-narrowing descriptor is computed (same steps as narrowing_descriptor) ------------\n","def descriptor_maps(img_u8, x, y, w, h, sigmas, margin=1.0, pad=16):\n","    H, W = img_u8.shape\n","    cx, cy = x + w / 2, y + h / 2\n","    hw, hh = w / 2 * (1 + margin), h / 2 * (1 + margin)\n","    x0, x1 = int(max(0, cx - hw - pad)), int(min(W, cx + hw + pad))\n","    y0, y1 = int(max(0, cy - hh - pad)), int(min(H, cy + hh + pad))\n","    crop = img_u8[y0:y1, x0:x1].astype(np.float32) / 255.0\n","    lam, V = hessian_scale_space(crop, sigmas)\n","    vmax, sig = V.max(0), np.asarray(sigmas)[lam.argmax(0)]\n","    mask = remove_small(vmax > filters.threshold_otsu(vmax), max_size=30)\n","    skel = morphology.skeletonize(mask)\n","    yy, xx = np.mgrid[y0:y1, x0:x1]\n","    core = (xx >= x) & (xx < x + w) & (yy >= y) & (yy < y + h)\n","    ring = (np.abs(xx - cx) <= hw) & (np.abs(yy - cy) <= hh) & ~core\n","    lab = measure.label(skel, connectivity=2)\n","    ids = [i for i in np.unique(lab[core & skel]) if i > 0]\n","    comp = lab == max(ids, key=lambda i: np.sum((lab == i) & core)) if ids else np.zeros_like(skel)\n","    return dict(crop=crop, vmax=vmax, sig=np.where(mask, sig, np.nan), mask=mask, core_pts=comp & core, flank_pts=comp & ring,\n","                box=(x - x0, y - y0, w, h), ring=(cx - hw - x0, cy - hh - y0, 2 * hw, 2 * hh))\n","\n","ok = boxes.dropna(subset=[\"R_edt\"]).query(\"n_core >= 8 and n_flank >= 15 and w >= 25 and h >= 25\")\n","examples = []\n","for lv in (0, 2, 4):\n","    g = ok[ok.level == lv]\n","    if len(g):\n","        examples.append(g.iloc[(g.R_edt - g.R_edt.median()).abs().argsort().iloc[0]])\n","if examples:\n","    fig, ax = plt.subplots(len(examples), 4, figsize=(9, 2.4 * len(examples)), squeeze=False)\n","    for row, r in zip(ax, examples):\n","        dm = descriptor_maps(load_gray(paths[r.frame]), r.x, r.y, r.w, r.h, CFG[\"desc_sigmas\"])\n","        row[0].imshow(dm[\"crop\"], cmap=\"gray\"); row[0].add_patch(plt.Rectangle(dm[\"box\"][:2], *dm[\"box\"][2:], fill=False, ec=\"red\", lw=1.2))\n","        row[0].add_patch(plt.Rectangle(dm[\"ring\"][:2], *dm[\"ring\"][2:], fill=False, ec=\"yellow\", lw=1, ls=\"--\"))\n","        row[0].set_ylabel(f\"{r.grade}\\nR_edt={r.R_edt:.2f}\", fontsize=9)\n","        row[1].imshow(dm[\"vmax\"], cmap=\"magma\")\n","        im = row[2].imshow(dm[\"sig\"], cmap=\"viridis\"); fig.colorbar(im, ax=row[2], fraction=0.046, pad=0.02)\n","        row[3].imshow(dm[\"mask\"], cmap=\"gray\", alpha=0.5)\n","        cy_, cx_ = np.nonzero(dm[\"core_pts\"]); fy_, fx_ = np.nonzero(dm[\"flank_pts\"])\n","        row[3].scatter(fx_, fy_, s=2, c=\"#4C72B0\", label=\"flank skeleton\"); row[3].scatter(cx_, cy_, s=2, c=\"#C44E52\", label=\"core skeleton\")\n","        for a in row:\n","            a.set_xticks([]); a.set_yticks([]); [sp.set_visible(False) for sp in a.spines.values()]\n","    for a, t in zip(ax[0], [\"Crop (box red, flanks yellow)\", \"Frangi vesselness V\", \"Best scale σ* (px)\", \"Lesion vessel: core vs flanks\"]):\n","        a.set_title(t, fontsize=9)\n","    ax[0, 3].legend(loc=\"lower right\", fontsize=7, markerscale=4)\n","    save_fig(fig, \"fig_descriptor_method\", \"Computation of the unitless relative-narrowing descriptor for three lesions of increasing grade \"\n","             \"(rows; examples with R_edt closest to the median of their level). The vessel mask is the Otsu-thresholded multiscale Frangi \"\n","             \"response; the lesioned vessel is the skeleton component with most pixels inside the box. R_edt compares the 10th-percentile \"\n","             \"mask width in the core with the median width on the flanks; R_sigma does the same with the Hessian best scale σ*.\")\n","\n","# ---- Figure: descriptor vs grade (Part B pilot) ----------------------------------------------------------------\n","fig, ax = plt.subplots(1, 2, figsize=(10, 3.2), gridspec_kw=dict(width_ratios=[1, 1.4]))\n","pl = pilot.iloc[::-1].reset_index(drop=True)\n","ax[0].errorbar(pl.spearman, range(len(pl)), xerr=[pl.spearman - pl.ci_lo, pl.ci_hi - pl.spearman], fmt=\"o\", color=\"k\", capsize=3, ms=4)\n","ax[0].axvline(0, color=\"0.5\", lw=1, ls=\"--\")\n","ax[0].set_yticks(range(len(pl)), [f\"{d}  ({s.replace('excluding p99/p100 (occlusion)', 'excl. occlusion')}, n={n})\"\n","                                  for d, s, n in zip(pl.descriptor, pl.subset, pl.n)], fontsize=7)\n","ax[0].set(xlabel=\"Spearman ρ with 7-level grade [patient-bootstrap 95% CI]\", title=\"(a) Descriptor–grade association\")\n","data = [boxes.loc[(boxes.grade == g) & boxes.R_edt.notna(), \"R_edt\"] for g in GRADES]\n","ax[1].boxplot(data, showfliers=False); ax[1].set_xticks(range(1, 8), GRADES, rotation=30)\n","ax[1].set(ylabel=\"R_edt (relative narrowing)\", title=\"(b) R_edt by annotated grade\")\n","save_fig(fig, \"fig_descriptor_vs_grade\", \"Part B pilot. (a) Spearman correlation between each descriptor and the 7-level clinician grade \"\n","         \"with patient-cluster bootstrap 95% CIs, for all boxes, without total/subtotal occlusions (p99/p100), and at track level. \"\n","         \"(b) R_edt by grade; occluded lesions (p99/p100) have no measurable lumen, which is a known failure mode.\")\n","save_table(pilot.round(3), \"table_descriptor_pilot\", \"Descriptor–grade Spearman correlations (patient-cluster bootstrap 95% CI, \"\n","           f\"{CFG['n_boot']} resamples). Pre-registered gate: CI excludes 0 for at least one descriptor (all grades).\")\n","KEY[\"pilot\"] = dict(gate_B=GATE_B, coverage=float(boxes.R_edt.notna().mean()),\n","                    rows=pilot.round(4).to_dict(\"records\"))\n"]},{"cell_type":"code","execution_count":23,"id":"cd30a88f","metadata":{"execution":{"iopub.execute_input":"2026-11-08T21:57:28.760312Z","iopub.status.busy":"2026-11-08T21:57:28.759959Z","iopub.status.idle":"2026-11-08T21:58:51.492968Z","shell.execute_reply":"2026-11-08T21:58:51.492151Z"},"papermill":{"duration":82.766494,"end_time":"2026-11-08T21:58:51.494563+00:00","exception":false,"start_time":"2026-11-08T21:57:28.728069+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Variant</th>\n","      <th>Runs</th>\n","      <th>AP50</th>\n","      <th>F1</th>\n","      <th>Precision</th>\n","      <th>Sensitivity</th>\n","      <th>Sens. @0.5 FP/img</th>\n","      <th>F1 (centre-hit)</th>\n","      <th>F1 (IoU≥0.3)</th>\n","      <th>Video AUROC</th>\n","      <th>Pooled F1 [95% CI]</th>\n","      <th>Pooled Sensitivity [95% CI]</th>\n","      <th>Pooled Precision [95% CI]</th>\n","      <th>Pooled Video AUROC [95% CI]</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>Raw</td>\n","      <td>10</td>\n","      <td>0.083 ± 