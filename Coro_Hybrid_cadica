ORS = {\"frame_random\": \"#C44E52\", \"video_grouped\": \"#DD8452\", \"patient_grouped\": \"#4C72B0\"}\n","\n","def inflation_rows(df, metrics, task):\n","    base = df[df.regime == \"patient_grouped\"]\n","    out = []\n","    for r in [r for r in REGIMES if r in set(df.regime)]:\n","        d = df[df.regime == r]\n","        row = {\"Task\": task, \"Split\": REGIME_NAMES[r], \"Runs\": len(d)}\n","        for col, name in metrics:\n","            row[name] = msd_str(d[col])\n","        col0, name0 = metrics[0]\n","        if len(base) and r != \"patient_grouped\":\n","            gap = d[col0].mean() - base[col0].mean()\n","            row[f\"Δ{name0} vs patient\"] = f\"{gap:+.3f}\"\n","            row[\"Relative\"] = f\"{100 * gap / base[col0].mean():+.0f}%\" if base[col0].mean() > 0 else \"–\"\n","            KEY.setdefault(\"leakage\", {})[f\"{task}:{r}\"] = dict(mean=float(d[col0].mean()), patient=float(base[col0].mean()), gap=float(gap))\n","        out.append(row)\n","    return out\n","\n","LEAK_CAP = (\"Effect of the splitting protocol with otherwise identical models and settings (mean ± SD over folds × seeds). \"\n","            \"Frame-random: the same lesion/patient can be in training and test; video-grouped: no shared video, but other projections \"\n","            \"of the same patient can be in training; patient-grouped: correct protocol. Δ and Relative: difference of the first metric \"\n","            \"from the patient-grouped split.\")\n","if len(leak):\n","    save_table(pd.DataFrame(inflation_rows(leak, [(\"QWK\", \"QWK\"), (\"MAE\", \"MAE\"), (\"acc_pm1\", \"Accuracy ±1\")], \"Severity (CNN raw)\")),\n","               \"table6a_leakage_severity\", \"Severity grading (CNN raw). \" + LEAK_CAP)\n","if len(det_leak):\n","    save_table(pd.DataFrame(inflation_rows(det_leak, [(\"test_AP50\", \"AP50\"), (\"test_F1\", \"F1\"), (\"test_video_AUROC\", \"Video AUROC\")], \"Detection (raw)\")),\n","               \"table6b_leakage_detection\", f\"Stenosis detection (raw detector, seed {CFG['det_seeds'][0]}). \" + LEAK_CAP)\n","if len(leak) or len(det_leak):\n","    panels = ([(\"Severity grading\", leak, \"QWK\", \"QWK\")] if len(leak) else []) + \\\n","             ([(\"Detection\", det_leak, \"test_AP50\", \"AP50\"), (\"Detection\", det_leak, \"test_F1\", \"F1\")] if len(det_leak) else [])\n","    fig, ax = plt.subplots(1, len(panels), figsize=(3.8 * len(panels), 3.1), squeeze=False, gridspec_kw=dict(wspace=0.35))\n","    for a, (task, df, col, name) in zip(ax[0], panels):\n","        regs = [r for r in REGIMES if r in set(df.regime)]\n","        means = [df[df.regime == r][col].mean() for r in regs]\n","        a.bar(range(len(regs)), means, color=[REG_COLORS[r] for r in regs], alpha=0.6)\n","        for i, r in enumerate(regs):\n","            y = df[df.regime == r][col].values\n","            a.scatter(np.full(len(y), i) + np.random.default_rng(i).uniform(-0.15, 0.15, len(y)), y, s=10, color=\"k\", zorder=3)\n","            a.text(i, means[i], f\"{means[i]:.3f}\", ha=\"center\", va=\"bottom\", fontsize=8)\n","        a.set_xticks(range(len(regs)), [REGIME_NAMES[r] for r in regs], rotation=15); a.set(ylabel=name, title=f\"{task}: {name}\")\n","    save_fig(fig, \"fig_leakage\", \"Headline result: the same models evaluated under frame-random, video-grouped and patient-grouped \"\n","             \"splits. Bars: mean; dots: individual fold × seed runs. Leaky splits overstate performance on unseen patients.\")\n","\n","# ---- Table: external validation (ARCADE) --------------------------------------------------------------------------\n","arc_f = OUT / \"tables/external_arcade.csv\"\n","if arc_f.exists():\n","    ext_ = pd.read_csv(arc_f)\n","    save_table(ext_.assign(variant=ext_.variant.map(lambda v: VAR_NAMES.get(v, v))).round(3), \"table7_external_arcade\",\n","               \"Zero-shot external validation on the ARCADE stenosis test set (stenoses ≥50%, matching label definition L2). \"\n","               \"Models trained on all CADICA patients; thresholds from CADICA cross-validation.\")\n","    KEY[\"external_arcade\"] = ext_.round(4).to_dict(\"records\")\n","\n","# ---- Table: hypotheses --------------------------------------------------------------------------------------------\n","if len(H):\n","    save_table(H, \"table8_hypotheses\", \"Pre-registered hypotheses and their verdicts under the rejection rules of protocol.json.\")\n","    KEY[\"hypotheses\"] = H.to_dict(\"records\")\n"]},{"cell_type":"code","execution_count":26,"id":"e1f45a45","metadata":{"execution":{"iopub.execute_input":"2026-11-18T13:59:05.201765Z","iopub.status.busy":"2026-11-18T13:59:05.201394Z","iopub.status.idle":"2026-11-18T13:59:19.789533Z","shell.execute_reply":"2026-11-18T13:59:19.788555Z"},"papermill":{"duration":14.63158,"end_time":"2026-11-18T13:59:19.791129+00:00","exception":false,"start_time":"2026-11-18T13:59:05.159549+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Model</th>\n","      <th>Parameters (M)</th>\n","      <th>Inference, ms/frame</th>\n","      <th>of which Frangi, ms</th>\n","      <th>Training, min/run</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>Detector: Raw</td>\n","      <td>18.93</td>\n","      <td>20.9</td>\n","      <td>0.0</td>\n","      <td>15.7</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>Detector: Frangi early</td>\n","      <td>18.93</td>\n","      <td>25.4</td>\n","      <td>5.6</td>\n","      <td>15.9</td>\n","    </tr>\n","    <tr>\n","    