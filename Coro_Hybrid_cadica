ank\"]] = np.log1p(X[[\"n_core\", \"n_flank\"]])\n","    X = X.fillna(0.0).values\n","    if stats is None:\n","        stats = (X.mean(0), X.std(0) + 1e-6)\n","    return (X - stats[0]) / stats[1], stats\n","\n","def crop_box(img, r, size):\n","    s = max(r.w, r.h) * 1.5; cx, cy = r.x + r.w / 2, r.y + r.h / 2\n","    x0, y0 = int(round(cx - s / 2)), int(round(cy - s / 2)); x1, y1 = x0 + int(round(s)), y0 + int(round(s))\n","    pad = max(0, -x0, -y0, x1 - img.shape[1], y1 - img.shape[0])\n","    im = np.pad(img, pad, mode=\"reflect\") if pad else img\n","    c = im[y0 + pad:y1 + pad, x0 + pad:x1 + pad]\n","    return cv2.resize(c, (size, size), interpolation=cv2.INTER_AREA)\n","\n","class CropStore:\n","    def __init__(self, bx):\n","        self.raw, self.ves = {}, {}\n","        def load(fr, g):                                    # Frangi maps were built by build_frangi_cache beforehand\n","            img = load_gray(paths[fr])\n","            vp = frangi_cache_path(fr)\n","            ves = cv2.imread(str(vp), cv2.IMREAD_GRAYSCALE) if vp.exists() else None\n","            return fr, img, ves, g\n","        t = time.time()\n","        for fr, img, ves, g in Parallel(n_jobs=16, prefer=\"threads\")(delayed(load)(fr, g) for fr, g in bx.groupby(\"frame\")):\n","            if ves is None:\n","                ves = frangi_full(paths[fr], CFG[\"frangi_sigmas_full\"]); cv2.imwrite(str(frangi_cache_path(fr)), ves)\n","            for r in g.itertuples():\n","                self.raw[r.uid] = crop_box(img, r, CFG[\"sev_crop\"]); self.ves[r.uid] = crop_box(ves, r, CFG[\"sev_crop\"])\n","        print(f\"CropStore: {len(self.raw)} crops in {time.time() - t:.0f}s\", flush=True)\n","\n","class SevDataset(Dataset):\n","    def __init__(self, bx, cs, use_frangi, X, train):\n","        self.b = bx.reset_index(drop=True); self.cs, self.uf, self.X, self.train = cs, use_frangi, X.astype(np.float32), train\n","    def __len__(self):\n","        return len(self.b)\n","    def __getitem__(self, i):\n","        u = self.b.uid[i]\n","        I = self.cs.raw[u].astype(np.float32) / 255.0\n","        V = self.cs.ves[u].astype(np.float32) / 255.0 if self.uf else I\n","        x = np.stack([I, V, I])\n","        if self.train:\n","            if random.random() < 0.5:\n","                x = x[:, :, ::-1]\n","            if random.random() < 0.5:\n","                x = x[:, ::-1, :]\n","            x = x.copy(); a, c = random.uniform(.85, 1.15), random.uniform(-.08, .08)\n","            x[0] = np.clip(x[0] * a + c, 0, 1); x[2] = x[0]\n","            if not self.uf:\n","                x[1] = x[0]\n","        x = (x - 0.45) / 0.225\n","        return torch.from_numpy(x), torch.from_numpy(self.X[i]), int(self.b.level[i])\n","\n","class OrdinalNet(nn.Module):\n","    def __init__(self, n_desc, use_desc, K=5):\n","        super().__init__()\n","        bb = torchvision.models.resnet18(weights=\"DEFAULT\"); nf = bb.fc.in_features; bb.fc = nn.Identity()\n","        self.bb, self.use_desc = bb, use_desc\n","        self.dproj = nn.Sequential(nn.Linear(n_desc, 32), nn.ReLU()) if use_desc else None\n","        self.head = nn.Sequential(nn.Dropout(0.3), nn.Linear(nf + (32 if use_desc else 0), K - 1))\n","    def forward(self, x, d):\n","        h = self.bb(x)\n","        if self.use_desc:\n","            h = torch.cat([h, self.dproj(d)], 1)\n","        return self.head(h)\n","\n","def ordinal_targets(y, K=5):\n","    return (y[:, None] > torch.arange(K - 1, device=y.device)[None]).float()\n","\n","def sev_metrics(y, p_exp):\n","    yhat = np.clip(np.rint(p_exp), 0, 4).astype(int)\n","    out = dict(QWK=cohen_kappa_score(y, yhat, weights=\"quadratic\"), MAE=float(np.mean(np.abs(y - yhat))),\n","               acc=float(np.mean(y == yhat)), acc_pm1=float(np.mean(np.abs(y - yhat) <= 1)))\n","    yb = (np.asarray(y) >= 3).astype(int)\n","    out[\"AUROC_ge70\"] = roc_auc_score(yb, p_exp) if len(np.unique(yb)) == 2 else np.nan\n","    return out\n","\n","@torch.no_grad()\n","def sev_predict(model, ds):\n","    model.eval(); P = []\n","    for x, d, _ in DataLoader(ds, 512, shuffle=False, num_workers=CFG[\"num_workers\"], pin_memory=PIN):\n","        with torch.autocast(DEVICE.type, enabled=DEVICE.type == \"cuda\"):\n","            logits = model(x.to(DEVICE, non_blocking=True), d.to(DEVICE, non_blocking=True))\n","        P.append(torch.sigmoid(logits.float()).cpu().numpy())\n","    return np.concatenate(P).sum(1)              # expected level = sum_k P(y>k)\n","\n","def train_severity(arm, tr, va, te, seed, cs):\n","    set_seed(seed)\n","    Xtr, st = desc_matrix(tr); Xva, _ = desc_matrix(va, st); Xte, _ = desc_matrix(te, st)\n","    if arm == \"desc_only\":\n","        P = []\n","        for Xs in (Xva, Xte):\n","            ps = []\n","            for k in range(4):\n","                yk = (tr.level.values > k).astype(int)\n","                clf = LogisticRegression(max_iter=2000, C=1.0, class_weight=\"balanced\").fit(Xtr, yk) if yk.min() != yk.max() else None\n","                ps.append(clf.predict_proba(Xs)[:, 1] if clf else np.full(len(Xs), float(yk.mean())))\n","            P.append(np.sum(ps, 0))\n","        return P[0], P[1]\n","    use_frangi, use_desc = \"frangi\" in arm, \"desc\" in arm\n","    model = OrdinalNet(Xtr.shape[1], use_desc).to(DEVICE)\n","    opt = torch.optim.AdamW(model.parameters(), lr=3e-4, weight_decay=1e-4)\n","    dl = DataLoader(SevDataset(tr, cs, use_frangi, Xtr, True), CFG[\"sev_batch\"], shuffle=True, num_workers=CFG[\"num_workers\"], drop_last=True, pin_memory=PIN)\n","    dva, dte = SevDataset(va, cs, use_frangi, Xva, False), SevDataset(te, cs, use_frangi, Xte, False)\n","    # class-balanced weights on cumulative targets\n","    pos_w = torch.tensor([(tr.level <= k).mean() / max((tr.level > k).mean(), 1e-3) for k in range(4)], device=DEVICE).float().clamp(0.2, 5)\n","    scaler = torch.amp.GradScaler(\"cuda\", enabled=DEVICE.type == \"cuda\")\n","    best, best_state = -9, None\n","    for ep in range(CFG[\"sev_epochs\"]):\n","        model.train()\n","        for x, d, y in dl:\n","            x, d, y = x.to(DEVICE, non_blocking=True), d.to(DEVICE, non_blocking=True), y.to(DEVICE, non_blocking=True)\n","            with torch.autocast(DEVICE.type, enabled=DEVICE.type == \"cuda\"):\n","                logits = model(x, d)\n","            loss = F.binary_cross_entropy_with_logits(logits.float(), ordinal_targets(y), pos_weight=pos_w)\n","            opt.zero_grad(set_to_none=True); scaler.scale(loss).backward(); scaler.step(opt); scaler.update()\n","        q = sev_metrics(va.level.values, sev_predict(model, dva))[\"QWK\"]\n","        if best_state is None or q > best:\n","            best, best_state = q, copy.deepcopy(model.state_dict())\n","    model.load_state_dict(best_state)\n","    pv, pt = sev_predict(model, dva), sev_predict(model, dte)\n","    del model; torch.cuda.empty_cache()\n","    return pv, pt\n","\n","SEV_ARMS = [\"desc_only\", \"cnn_raw\", \"cnn_frangi\", \"cnn_raw+desc\", \"cnn_frangi+desc\"]\n","sev_boxes = boxes if not FAST_DEV else boxes.groupby(\"patient\").head(40)\n","build_frangi_cache(frames[frames.frame.isin(sev_boxes.frame)])\n","cs = CropStore(sev_boxes)\n","\n","def sev_run_file(tag, fold, seed, arm):\n","    return OUT / \"sev_runs/runs\" / f\"{tag}_f{fold}_s{seed}_{arm}.csv\"\n","\n","def run_severity_cv(bx, folds, arms, seeds, tag):\n","    \"\"\"Trains the given folds (each run saved as soon as it finishes, finished runs skipped), then returns the\n","    out-of-fold predictions of EVERY finished fold, including folds trained in earlier sessions.\"\"\"\n","    for fold in folds:\n","        tr, va, te = (bx[bx.patient.isin(fold[s])] for s in (\"train\", \"val\", \"test\"))\n","        for seed in seeds:\n","            for arm in arms:\n","                f = sev_run_file(tag, fold[\"fold\"], seed, arm)\n","                if f.exists() or not budget_left(0.25):\n","                    continue\n","                _, pt = train_severity(arm, tr, va, te, seed, cs)\n","                te[[\"uid\", \"patient\", \"video\", \"track\", \"level\", \"g7\"]].assign(arm=arm, seed=seed, fold=fold[\"fold\"], p_exp=pt).to_csv(f, index=False)\n","                print(f\"  {tag} fold{fold['fold']} seed{seed} {arm}: QWK={sev_metrics(te.level.values, pt)['QWK']:.3f}\", flush=True)\n","    done = [sev_run_file(tag, k, s, a) for k in range(CFG[\"n_outer_folds\"]) for s in seeds for a in arms]\n","    have = [f for f in done if f.exists()]\n","    print(f\"severity runs finished so far: {len(have)} / {len(done)}\")\n","    if not have:\n","        return pd.DataFrame(columns=[\"uid\", \"patient\", \"video\", \"track\", \"level\", \"g7\", \"arm\", \"seed\", \"fold\", \"p_exp\"])\n","    oof = pd.concat([pd.read_csv(f) for f in have], ignore_index=True)\n","    oof.to_csv(OUT / \"sev_runs\" / f\"{tag}_oof.csv\", index=False)\n","    return oof\n","\n","sev_oof = run_severity_cv(sev_boxes, [FOLDS[i] for i in FOLDS_TO_RUN], SEV_ARMS, CFG[\"sev_seeds\"], \"patientCV\")\n","\n","def summarise_sev(oof, level=\"box\"):\n","    rows = []\n","    for (arm, seed), g in oof.groupby([\"arm\", \"seed\"]):\n","        if level == \"track\":       # Part C: aggregate along the lesion track\n","            g = g.groupby(\"track\").agg(patient=(\"patient\", \"first\"), level=(\"level\", lambda s: s.mode().max()), p_exp=(\"p_exp\", \"median\")).reset_index()\n","        est, lo, hi = patient_bootstrap(g, lambda d: sev_metrics(d.level.values, d.p_exp.values)[\"QWK\"], CFG[\"n_boot\"])\n","        rows.append(dict(arm=arm, seed=seed, unit=level, QWK=est, QWK_lo=lo, QWK_hi=hi,\n","                         **{k: v for k, v in sev_metrics(g.level.values, g.p_exp.values).items() if k != \"QWK\"}))\n","    return pd.DataFrame(rows)\n","\n","SEV_COMPLETE = len(list((OUT / \"sev_runs/runs\").glob(\"patientCV_*.csv\"))) >= len(SEV_ARMS) * len(CFG[\"sev_seeds\"]) * CFG[\"n_outer_folds\"]\n","sev_box = summarise_sev(sev_oof, \"box\") if len(sev_oof) else pd.DataFrame()\n","if len(sev_box):\n","    sev_box.to_csv(OUT / \"tables/partB_severity_box.csv\", index=False)\n","    display(sev_box.groupby(\"arm\")[[\"QWK\", \"QWK_lo\", \"QWK_hi\", \"MAE\", \"acc_pm1\", \"AUROC_ge70\"]].mean().round(3))"]},{"cell_type":"markdown","id":"c71c59c9","metadata":{"papermill":{"duration":0.019186,"end_time":"2026-11-08T20:00:48.695405+00:00","exception":false,"start_time":"2026-11-08T20:00:48.676219+00:00","status":"completed"},"tags":[]},"source":["## 10. Part C: sequence-level aggregation along lesion tracks\n","The same lesion appears in several keyframes. The track-level grade is the median predicted level along the track, compared with the track's most frequent annotated level. The track-linking sensitivity check re-links tracks with stricter and looser distance limits and checks that conclusions do not depend on this choice."]},{"cell_type":"code","execution_count":15,"id":"18d95b49","metadata":{"execution":{"iopub.execute_input":"2026-11-08T20:00:48.734649Z","iopub.status.busy":"2026-11-08T20:00:48.734394Z","iopub.status.idle":"2026-11-08T20:03:31.125843Z","shell.execute_reply":"2026-11-08T20:03:31.125003Z"},"papermill":{"duration":162.432182,"end_time":"2026-11-08T20:03:31.146459+00:00","exception":false,"start_time":"2026-11-08T20:00:48.714277+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>QWK_box</th>\n","      <th>QWK_track</th>\n","      <th>gain</th>\n","    </tr>\n","    <tr>\n","      <th>arm</th>\n","      <th></th>\n","      <th></th>\n"