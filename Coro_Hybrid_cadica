es      D_ves  5814     0.203   \n","3                      all grades | track-level      R_edt   750     0.297   \n","4                excluding p99/p100 (occlusion)    R_sigma  5550     0.151   \n","5                excluding p99/p100 (occlusion)      R_edt  5550     0.323   \n","6                excluding p99/p100 (occlusion)      D_ves  5550     0.219   \n","7  excluding p99/p100 (occlusion) | track-level      R_edt   728     0.324   \n","\n","   ci_lo  ci_hi  \n","0  0.035  0.227  \n","1  0.194  0.358  \n","2  0.107  0.282  \n","3  0.189  0.380  \n","4  0.059  0.250  \n","5  0.237  0.392  \n","6  0.112  0.305  \n","7  0.212  0.412  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["GATE B: PASSED - descriptor carries severity signal; keep Part B as main hook\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1500x380 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["def patient_bootstrap(df, stat_fn, n_boot, seed=0, group=\"patient\"):\n","    \"\"\"Point estimate and 95% CI of stat_fn(df), resampling whole patients with replacement.\"\"\"\n","    rng = np.random.default_rng(seed)\n","    groups = {k: v for k, v in df.groupby(group)}\n","    keys = list(groups)\n","    est, boots = stat_fn(df), []\n","    for _ in range(n_boot):\n","        b = pd.concat([groups[k] for k in rng.choice(keys, len(keys))])\n","        try:\n","            boots.append(stat_fn(b))\n","        except ValueError:\n","            pass\n","    lo, hi = np.nanpercentile(boots, [2.5, 97.5])\n","    return est, lo, hi\n","\n","def rho_fn(col, target=\"g7\"):\n","    return lambda d: spearmanr(d[col], d[target]).correlation\n","\n","pilot = []\n","for subset, d0 in [(\"all grades\", boxes), (\"excluding p99/p100 (occlusion)\", boxes[boxes.g7 <= 4])]:\n","    for col in [\"R_sigma\", \"R_edt\", \"D_ves\"]:\n","        d = d0.dropna(subset=[col])\n","        est, lo, hi = patient_bootstrap(d, rho_fn(col), CFG[\"n_boot\"])\n","        pilot.append(dict(subset=subset, descriptor=col, n=len(d), spearman=est, ci_lo=lo, ci_hi=hi))\n","    # track-level: median descriptor vs most frequent grade along the lesion track\n","    t = d0.dropna(subset=[\"R_edt\"]).groupby(\"track\").agg(patient=(\"patient\", \"first\"), R_edt=(\"R_edt\", \"median\"),\n","                                                          g7=(\"g7\", lambda s: s.mode().max()))\n","    est, lo, hi = patient_bootstrap(t, rho_fn(\"R_edt\"), CFG[\"n_boot\"])\n","    pilot.append(dict(subset=subset + \" | track-level\", descriptor=\"R_edt\", n=len(t), spearman=est, ci_lo=lo, ci_hi=hi))\n","pilot = pd.DataFrame(pilot); pilot.to_csv(OUT / \"tables/pilot_partB.csv\", index=False); display(pilot.round(3))\n","\n","GATE_B = bool((pilot[pilot.subset == \"all grades\"].ci_lo > 0).any())\n","print(\"GATE B:\", \"PASSED - descriptor carries severity signal; keep Part B as main hook\" if GATE_B\n","      else \"FAILED - report as negative finding; centre the paper on Parts A + D\")\n","\n","fig, ax = plt.subplots(1, 3, figsize=(15, 3.8))\n","for a, col in zip(ax, [\"R_sigma\", \"R_edt\", \"D_ves\"]):\n","    data = [boxes.loc[(boxes.grade == g) & boxes[col].notna(), col] for g in GRADES]\n","    a.boxplot(data, showfliers=False); a.set_xticks(range(1, 8), GRADES, rotation=45); a.set_title(col)\n","plt.tight_layout(); plt.savefig(OUT / \"figures/pilot_descriptor_by_grade.png\", dpi=150); plt.show()"]},{"cell_type":"markdown","id":"f99d9f2d","metadata":{"papermill":{"duration":0.012029,"end_time":"2026-11-08T14:59:24.912515+00:00","exception":false,"start_time":"2026-11-08T14:59:24.900486+00:00","status":"completed"},"tags":[]},"source":["## 6. Patient-level splits (pre-registered)\n","\n","5 outer folds via `StratifiedGroupKFold`, grouped by patient and stratified by each patient's maximum lesion level. In each outer fold, about 1/6 of the training patients form the **validation** set. It is used for early stopping, threshold choice and normalisation only. Fold files are frozen in `results/protocol.json` before any model is trained."]},{"cell_type":"code","execution_count":8,"id":"0da996b0","metadata":{"execution":{"iopub.execute_input":"2026-11-08T14:59:24.931507Z","iopub.status.busy":"2026-11-08T14:59:24.930995Z","iopub.status.idle":"2026-11-08T14:59:25.027432Z","shell.execute_reply":"2026-11-08T14:59:25.026713Z"},"papermill":{"duration":0.107781,"end_time":"2026-11-08T14:59:25.029054+00:00","exception":false,"start_time":"2026-11-08T14:59:24.921273+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>fold</th>\n","      <th>n_train</th>\n","      <th>n_val</th>\n","      <th>n_test</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>0</td>\n","      <td>26</td>\n","      <td>7</td>\n","      <td>9</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>1</td>\n","      <td>27</td>\n","      <td>6</td>\n","      <td>9</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>2</td>\n","      <td>27</td>\n","      <td>7</td>\n","      <td>8</td>\n","    </tr>\n","    <tr>\n","      <th>3</th>\n","      <td>3</td>\n","      <td>29</td>\n","      <td>5</td>\n","      <td>8</td>\n","    </tr>\n","    <tr>\n","      <th>4</th>\n","      <td>4</td>\n","      <td>28</td>\n","      <td>6</td>\n","      <td>8</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["   fold  n_train  n_val  n_test\n","0     0       26      7       9\n","1     1       27      6       9\n","2     2       27      7       8\n","3     3       29      5       8\n","4     4       28      6       8"]},"execution_count":8,"metadata":{},"output_type":"execute_result"}],"source":["def make_outer_folds(frames, n, seed):\n","    pf = frames.groupby(\"patient\").patient_max_level.first()\n","    sgkf = StratifiedGroupKFold(n_splits=n, shuffle=True, random_state=seed)\n","    folds = []\n","    for k, (tr, te) in enumerate(sgkf.split(pf.index, pf.values, groups=pf.index)):\n","        trp, tep = pf.index[tr], pf.index[te]\n","        inner = StratifiedGroupKFold(n_splits=6, shuffle=True, random_state=seed + k)\n","        itr, iva = next(inner.split(trp, pf[trp].values, groups=trp))\n","        folds.append(dict(fold=k, train=sorted(trp[itr]), val=sorted(trp[iva]), test=sorted(tep)))\n","    return folds\n","\n","FOLDS = make_outer_folds(frames, CFG[\"n_outer_folds\"], CFG[\"seed\"])\n","for f in FOLDS:\n","    assert not (set(f[\"train\"]) & set(f[\"test\"])) and not (set(f[\"val\"]) & set(f[\"test\"])) and not (set(f[\"train\"]) & set(f[\"val\"]))\n","protocol = dict(cfg=CFG, grades=GRADES, level5=LEVEL5, folds=FOLDS, track_linking=dict(max_gap=2, max_dist=40),\n","                label_defs={\"L1\": \"all boxes positive\", \"L2\": \">=50% positive, <50% boxes ignored in training and evaluation\"},\n","                primary_metrics=[\"F1@IoU0.5 (val-chosen threshold)\", \"AP50\", \"video AUROC\", \"QWK (5-level)\"])\n","pf = OUT / \"protocol.json\"\n","if not pf.exists():\n","    pf.write_text(json.dumps(protocol, indent=2, default=str))\n","else:\n","    assert json.loads(pf.read_text())[\"folds\"] == json.loads(json.dumps(FOLDS, default=str)), \\\n","        \"protocol.json folds changed - delete it deliberately if you really want new folds\"\n","pd.DataFrame([dict(fold=f[\"fold\"], n_train=len(f[\"train\"]), n_val=len(f[\"val\"]), n_test=len(f[\"test\"])) for f in FOLDS])"]},{"cell_type":"markdown","id":"3a23d88f","metadata":{"papermill":{"duration":0.009599,"end_time":"2026-11-08T14:59:25.048855+00:00","exception":false,"start_time":"2026-11-08T14:59:25.039256+00:00","status":"completed"},"tags":[]},"source":["## 7. Part A: hybrid CNN + Frangi stenosis detector\n","\n","Detector: torchvision Faster R-CNN (ResNet-50-FPN v2 or MobileNetV3-FPN), COCO-pretrained, with one \"stenosis\" class. Five input variants are implemented; the three in `CFG['det_variants']` (`raw`, `frangi_early`, `frangi_gated`) are run by default are compared on **identical folds and seeds**:\n","\n","| Variant | Input | What it tests |\n","|---|---|---|\n","| `raw` | [I, I, I] | baseline |\n","| `clahe` | [I, CLAHE(I), I] | classical contrast enhancement (control for \"any extra channel\") |\n","| `frangi_early` | [I, V, I] | early fusion of Frangi vesselness (as in prior preprocessing work) |\n","| `frangi_gated` | [I, I, I] + V | **gated mid-level fusion**: a small conv branch on V modulates every FPN level, `f·(1+tanh(g(V)))`. Zero-initialised, so it starts as the identity |\n","| `temporal` | [I(t−2), I(t), I(t+2)] | **short-range temporal context** from the full cine loop: a stenosis persists across neighbouring frames, overlaps and noise do not |\n","\n","Label definition **L2** (primary): boxes ≥50% are positives. Boxes <50% are *ignored*: they are removed from training targets, and predictions overlapping them are neither TP nor FP. Non-lesion keyframes are negatives."]},{"cell_type":"code","execution_count":9,"id":"d56cf37a","metadata":{"execution":{"iopub.execute_input":"2026-11-08T14:59:25.069067Z","iopub.status.busy":"2026-11-08T14:59:25.068811Z","iopub.status.idle":"2026-11-08T14:59:25.092104Z","shell.execute_reply":"2026-11-08T14:59:25.091518Z"},"papermill":{"duration":0.035634,"end_time":"2026-11-08T14:59:25.093478+00:00","exception":false,"start_time":"2026-11-08T14:59:25.057844+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["from torchvision.models.detection import fasterrcnn_resnet50_fpn_v2, fasterrcnn_mobilenet_v3_large_fpn\n","from torchvision.models.detection.faster_rcnn import FastRCNNPredictor\n","from torchvision.models.detection.transform import GeneralizedRCNNTransform\n","\n","def det_targets(frame_boxes, label_def):\n","    xyxy = xywh2xyxy(frame_boxes) if len(frame_boxes) else np.zeros((0, 4))\n","    if label_def == \"L1\":\n","        return xyxy, np.zeros((0, 4))\n","    pos = (frame_boxes.level >= 2).values if len(frame_boxes) else np.zeros(0, bool)\n","    return xyxy[pos], xyxy[~pos]\n","\n","def neighbour_path(path, fidx, video_len, offset):\n","    \"\"\"Path of the frame `offset` positions away in the same video (clamped to the video; falls back to the frame itself).\"\"\"\n","    p = Path(path)\n","    j = int(min(max(fidx + offset, 1), video_len or fidx))\n","    q = p.with_name(f\"{p.stem.rsplit('_', 1)[0]}_{j:05d}{p.suffix}\")\n","    return q if q.exists() else p\n","\n","class FrameStore:\n","    \"\"\"Keeps keyframes, their Frangi maps, CLAHE images and (for the temporal variant) the frames t-k / t+k in RAM.\"\"\"\n","    def __init__(self, frame_df, temporal=None):\n","        temporal = (\"temporal\" in CFG[\"det_variants\"]) if temporal is None else temporal\n","        k = CFG[\"det_temporal_offset\"]\n","        rows = list(frame_df.itertuples())\n","        def load(r):\n","            img = load_gray(r.path)\n","            nb = None\n","            if temporal:\n","                vl = getattr(r, \"video_len\", None)\n","                fi = getattr(r, \"fidx\", None)\n","                nb = (load_gray(neighbour_path(r.path, fi, vl, -k)), load_gray(neighbour_path(r.path, fi, vl, k))) if fi else (img, img)\n","            return r.frame, img, cv2.imread(str(frangi_cache_path(r.frame)), cv2.IMREAD_GRAYSCALE), CLAHE.apply(img), nb\n","        t = time.time()\n","        out = Parallel(n_jobs=16, prefer=\"threads\")(delayed(load)(r) for r in rows)\n","        self.img = {o[0]: o[1] for o in out}\n","        self.ves = {o[0]: o[2] for o in out}\n","        self.cla = {o[0]: o[3] for o in out}\n","        self.nb = {o[0]: o[4] for o in out if o[4] is not None}\n","        print(f\"FrameStore: {len(rows)} frames in {time.time() - t:.0f}s (temporal neighbours: {len(self.nb)})\", flush=True)\n","\n","def make_input(img, ves, variant, cla=None, nb=None):\n","    I = img.astype(np.float32) / 255.0\n","    if variant == \"temporal\":\n","        prev, nxt = nb if nb is not None else (img, img)\n","        return np.stack([prev.astype(np.float32) / 255.0, I, nxt.astype(np.float32) / 255.0], 0)\n","    if variant == \"raw\":\n","        chans = [I, I, I]\n","    elif variant == \"clahe\":\n","        chans = [I, (cla if cla is not None else CLAHE.apply(img)).astype(np.float32) / 255.0, I]\n","    elif variant == \"frangi_early\":\n","        chans = [I, ves.astype(np.float32) / 255.0, I]\n","    elif variant == \"frangi_gated\":\n","        chans = [I, I, I, ves.astype(np.float32) / 255.0]\n","    else:\n","        raise ValueError(variant)\n","    return np.stack(chans, 0)\n","\n","class DetDataset(Dataset):\n","    def __init__(self, frame_df, boxes_df, store, variant, label_def, train):\n","        self.f = frame_df.reset_index(drop=True); self.store, self.variant, self.train = store, variant, train\n","        bx = boxes_df.groupby(\"frame\")\n","        self.t = {fr: det_targets(bx.get_group(fr) if fr in bx.groups else boxes_df.iloc[:0], label_def) for fr in self.f.frame}\n","    def __len__(self):\n","        return len(self.f)\n","    def __getitem__(self, i):\n","        fr = self.f.frame[i]\n","        x = make_input(self.store.img[fr], self.store.ves[fr], self.variant, self.store.cla.get(fr), self.store.nb.get(fr))\n","        pos, ign = self.t[fr]\n","        pos = pos.copy()\n","        if self.train:\n","            if random.random() < 0.5:                          # horizontal flip\n","                x = x[:, :, ::-1].copy(); W = x.shape[2]\n","                pos[:, [0, 2]] = W - pos[:, [2, 0]]\n","            a, b = random.uniform(0.85, 1.15), random.uniform(-0.08, 0.08)   # intensity jitter on raw channel(s)\n","            x[0] = np.clip(x[0] * a + b, 0, 1)\n","            if self.variant == \"temporal\":                     # all three channels are raw frames: same jitter\n","                x[1:3] = np.clip(x[1:3] * a + b, 0, 1)\n","            elif self.variant in (\"raw\", \"frangi_gated\"):\n","                x[1], x[2] = x[0], x[0]\n","            else:\n","                x[2] = x[0]\n","        tgt = dict(boxes=torch.as_tensor(pos, dtype=torch.float32).reshape(-1, 4),\n","                   labels=torch.ones(len(pos), dtype=torch.int64))\n","        return torch.from_numpy(np.ascontiguousarray(x)), tgt, fr\n","\n","def collate(b):\n","    return tuple(zip(*b))\n","\n","class GatedVesselnessBackbone(nn.Module):\n","    \"\"\"Wraps a torchvision BackboneWithFPN; channel 4 of the input (Frangi V) gates every FPN level.\"\"\"\n","    def __init__(self, body):\n","        super().__init__()\n","        self.body, self.out_channels = body, body.out_channels\n","        self.vnet = nn.Sequential(nn.Conv2d(1, 16, 3, padding=1), nn.ReLU(inplace=True),\n","                                  nn.Conv2d(16, 16, 3, padding=1, stride=2), nn.ReLU(inplace=True))\n","        was_training = body.training; body.eval()          # probe in eval mode so BatchNorm running stats stay untouched\n","        with torch.no_grad():\n","            keys = list(body(torch.zeros(1, 3, 128, 128)).keys())\n","        body.train(was_training)\n","        self.gates = nn.ModuleDict({k: nn.Conv2d(16, self.out_channels, 1) for k in keys})\n","        for g in self.gates.values():\n","            nn.init.zeros_(g.weight); nn.init.zeros_(g.bias)\n","    def forward(self, x):\n","        feats = self.body(x[:, :3])\n","        h = self.vnet(x[:, 3:4])\n","        return OrderedDict((k, f * (1 + torch.tanh(self.gates[k](F.interpolate(h, size=f.shape[-2:], mode=\"bilinear\",\n","                                                                                align_corners=False)))))\n","                           for k, f in feats.items())\n","\n","def build_detector(arch, variant):\n","    m = fasterrcnn_resnet50_fpn_v2(weights=\"DEFAULT\") if arch == \"resnet50\" else fasterrcnn_mobilenet_v3_large_fpn(weights=\"DEFAULT\")\n","    m.roi_heads.box_predictor = FastRCNNPredictor(m.roi_heads.box_predictor.cls_score.in_features, 2)\n","    mean, std = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]\n","    if variant == \"frangi_gated\":\n","        m.backbone = GatedVesselnessBackbone(m.backbone); mean, std = mean + [0.0], std + [1.0]\n","    m.transform = GeneralizedRCNNTransform(CFG[\"det_size\"], CFG[\"det_size\"], mean, std)\n","    m.roi_heads.score_thresh, m.roi_heads.detections_per_img = 0.01, 20\n","    return m"]},{"cell_type":"markdown","id":"eddc6c05","metadata":{"papermill":{"duration":0.009547,"end_time":"2026-11-08T14:59:25.112099+00:00","exception":false,"start_time":"2026-11-08T14:59:25.102552+00:00","status":"completed"},"tags":[]},"source":["### 7.1 Evaluation: box-, video- and patient-level"]},{"cell_type":"code","execution_count":10,"id":"36d8d88c","metadata":{"execution":{"iopub.execute_input":"2026-11-08T14:59:25.131698Z","iopub.status.busy":"2026-11-08T14:59:25.131393Z","iopub.status.idle":"2026-11-08T14:59:25.14695Z","shell.execute_reply":"2026-11-08T14:59:25.146243Z"},"papermill":{"duration":0.02719,"end_time":"2026-11-08T14:59:25.148427+00:00","exception":false,"start_time":"2026-11-08T14:59:25.121237+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def match_image(pred, gts, ign, iou_thr=0.5, center_hit=False):\n","    \"\"\"pred: (N,5) xyxy+score sorted desc. Returns list[(score, tp)] and n_gt; predictions on ignored boxes are dropped.\"\"\"\n","    matched, out = np.zeros(len(gts), bool), []\n","    for p in pred:\n","        j = -1\n","        if len(gts):\n","            if center_hit:\n","                cx, cy = (p[0] + p[2]) / 2, (p[1] + p[3]) / 2\n","                ok = (gts[:, 0] <= cx) & (cx <= gts[:, 2]) & (gts[:, 1] <= cy) & (cy <= gts[:, 3]) & ~matched\n","                j = int(np.argmax(ok)) if ok.any() else -1\n","            else:\n","                iou = box_iou_np(p[:4], gts); iou[matched] = -1\n","                j = int(iou.argmax()) if iou.max() >= iou_thr else -1\n","        if j >= 0:\n","            matched[j] = True; out.append((p[4], 1))\n","        elif len(ign) and box_iou_np(p[:4], ign).max() >= 0.1:\n","            continue\n","        else:\n","            out.append((p[4], 0))\n","    return out, len(gts)\n","\n","def det_metrics(preds, targets, frame_meta, thr=None, iou_thr=0.5, center_hit=False):\n","    \"\"\"preds: {frame: (N,5)}, targets: {frame: (pos, ign)}. Returns dict incl. AP50, best/val-threshold F1, FROC, video AUROC.\"\"\"\n","    sc, tp, n_gt = [], [], 0\n","    for fr, (pos, ign) in targets.items():\n","        o, n = match_image(preds.get(fr, np.zeros((0, 5))), pos, ign, iou_thr, center_hit)\n","        n_gt += n; sc += [s for s, _ in o]; tp += [t for _, t in o]\n","    sc, tp = np.array(sc), np.array(tp)\n","    order = np.argsort(-sc); sc, tp = sc[order], tp[order]\n","    ctp, cfp = np.cumsum(tp), np.cumsum(1 - tp)\n","    rec = ctp / max(n_gt, 1); prec = ctp / np.maximum(ctp + cfp, 1)\n","    mrec = np.concatenate([[0], rec, [1]]); mpre = np.concatenate([[1], prec, [0]])\n","    mpre = np.maximum.accumulate(mpre[::-1])[::-1]\n","    ap = float(np.sum((mrec[1:] - mrec[:-1]) * mpre[1:]))\n","    f1 = 2 * prec * rec / np.maximum(prec + rec, 1e-9)\n","    best_i = int(np.argmax(f1)) if len(f1) else 0\n","    best_thr = float(sc[best_i]) if len(sc) else 0.5\n","    use_thr = best_thr if thr is None else thr\n","    k = int(np.sum(sc >= use_thr)); TP = int(ctp[k - 1]) if k else 0; FP = k - TP\n","    P, R = TP / max(TP + FP, 1), TP / max(n_gt, 1)\n","    n_img = len(targets)\n","    froc = {f\"sens@{r}FPpi\": float(rec[np.searchsorted(cfp / n_img, r, side=\"right\") - 1]) if len(rec) and (cfp / n_img)[0] <= r else 0.0\n","            for r in (0.25, 0.5, 1.0)}\n","    # video level: max score per video vs \"video contains a positive box\"\n","    fm = frame_meta.set_index(\"frame\")\n","    vs = pd.DataFrame([dict(video=fm.video[fr], patient=fm.patient[fr],\n","                            score=float(preds[fr][:, 4].max()) if fr in preds and len(preds[fr]) else 0.0,\n","                            label=int(len(targets[fr][0]) > 0)) for fr in targets])\n","    vv = vs.groupby(\"video\").agg(score=(\"score\", \"max\"), label=(\"label\", \"max\"), patient=(\"patient\", \"first\"))\n","    vauc = roc_auc_score(vv.label, vv.score) if vv.label.nunique() == 2 else np.nan\n","    return dict(AP50=ap, F1=2 * P * R / max(P + R, 1e-9), P=P, R=R, thr=use_thr, best_thr=best_thr,\n","                video_AUROC=vauc, n_gt=n_gt, **froc)\n","\n","@torch.no_grad()\n","def predict(model, ds, bs=16, device=None):\n","    dev = device or DEVICE\n","    model.eval(); out = {}\n","    for xs, _, frs in DataLoader(ds, bs, shuffle=False, num_workers=DET_WORKERS, collate_fn=collate, pin_memory=PIN):\n","        with torch.autocast(dev.type, enabled=dev.type == \"cuda\"):\n","            res = model([x.to(dev, non_blocking=True) for x in xs])\n","        for fr, r in zip(frs, res):\n","            out[fr] = np.concatenate([r[\"boxes\"].float().cpu().numpy(), r[\"scores\"].float().cpu().numpy()[:, None]], 1)\n","    return out"]},{"cell_type":"markdown","id":"de88972d","metadata":{"papermill":{"duration":0.009022,"end_time":"2026-11-08T14:59:25.166841+00:00","exception":false,"start_time":"2026-11-08T14:59:25.157819+00:00","status":"completed"},"tags":[]},"source":["### 7.2 Training (resumable experiment grid)"]},{"cell_type":"code","execution_count":11,"id":"19fa72c3","metadata":{"execution":{"iopub.execute_input":"2026-11-08T14:59:25.18677Z","iopub.status.busy":"2026-11-08T14:59:25.18601Z","iopub.status.idle":"2026-11-08T14:59:25.202808Z","shell.execute_reply":"2026-11-08T14:59:25.202219Z"},"papermill":{"duration":0.028256,"end_time":"2026-11-08T14:59:25.204214+00:00","exception":false,"start_time":"2026-11-08T14:59:25.175958+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def train_detector(variant, fold, seed, store, label_def=CFG[\"det_label_def\"], log=True, device=None):\n","    dev = device or DEVICE\n","    tag = f\"{variant}_{label_def}_{DET_ID}_s{seed}_f{fold['fold']}\"\n","    rdir = OUT / \"det_runs\" / tag\n","    if (rdir / \"metrics.json\").exists():\n","        return json.loads((rdir / \"metrics.json\").read_text())\n","    set_seed(seed)\n","    unit = fold.get(\"unit\", \"patient\")               # leakage folds split by frame or video instead of patient\n","    sub = lambda ids: frames[frames[unit].isin(ids) & frames.frame.isin(store.img.keys())]\n","    ds_tr = DetDataset(sub(fold[\"train\"]), boxes, store, variant, label_def, True)\n","    ds_va = DetDataset(sub(fold[\"val\"]), boxes, store, variant, label_def, False)\n","    ds_te = DetDataset(sub(fold[\"test\"]), boxes, store, variant, label_def, False)\n","    model = build_detector(CFG[\"det_arch\"], variant).to(dev)\n","    params = [p for p in model.parameters() if p.requires_grad]\n","    opt = torch.optim.SGD(params, lr=CFG[\"det_lr\"], momentum=0.9, weight_decay=1e-4)\n","    dl = DataLoader(ds_tr, CFG[\"det_batch\"], shuffle=True, num_workers=DET_WORKERS, collate_fn=collate, drop_last=True, pin_memory=PIN)\n","    total = CFG[\"det_epochs\"] * len(dl); warm = min(300, total // 10 + 1)\n","    sched = torch.optim.lr_scheduler.LambdaLR(opt, lambda it: min(1, (it + 1) / warm) * 0.5 * (1 + math.cos(math.pi * min(it, total) / total)))\n","    scaler = torch.amp.GradScaler(\"cuda\", enabled=DEVICE.type == \"cuda\")\n","    best, best_state, hist, t0 = -1, None, [], time.time()\n","    for ep in range(CFG[\"det_epochs\"]):\n","        model.train(); losses = []\n","        for xs, tg, _ in dl:\n","