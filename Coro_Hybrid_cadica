t)\n","def det_done(job):\n","    v, f, s = job\n","    return (OUT / \"det_runs\" / f\"{v}_{CFG['det_label_def']}_{DET_ID}_s{s}_f{f['fold']}\" / \"metrics.json\").exists()\n","def det_budget_ok(reserve_h):\n","    est = max(DET_RUN_H) if DET_RUN_H else CFG.get(\"det_run_est_h\", 1.0)\n","    return budget_left(est + reserve_h)\n","def run_det_job(job, dev=None, reserve_h=1.5):     # main grid keeps ~1.5 h for severity / leakage / summaries\n","    if det_done(job):\n","        return train_detector(*job, store, device=dev)\n","    if not det_budget_ok(reserve_h):\n","        return None\n","    t = time.time()\n","    m = train_detector(*job, store, device=dev)\n","    DET_RUN_H.append((time.time() - t) / 3600)\n","    return m\n","print(f\"{sum(map(det_done, det_jobs))} of {len(det_jobs)} detector runs already finished\", flush=True)\n","print(f\"{len(det_jobs)} detector runs on {len(GPUS)} GPU(s); finished runs are skipped (resumable)\", flush=True)\n","import queue\n","def run_det_jobs(jobs, reserve_h=1.5):\n","    \"\"\"Runs detector jobs, one per GPU at a time; finished runs are loaded, budget-exceeding runs are skipped.\"\"\"\n","    if len(GPUS) == 1:\n","        return [run_det_job(j, None, reserve_h) for j in jobs]\n","    free_gpus = queue.Queue()\n","    for g in GPUS:\n","        free_gpus.put(g)\n","    def _det_job(job):\n","        dev = free_gpus.get()                        # each GPU trains one run at a time\n","        try:\n","            with torch.cuda.device(dev):\n","                return run_det_job(job, dev, reserve_h)\n","        finally:\n","            torch.cuda.empty_cache(); free_gpus.put(dev)\n","    return Parallel(n_jobs=len(GPUS), prefer=\"threads\")(delayed(_det_job)(j) for j in jobs)\n","det_results = run_det_jobs(det_jobs)\n","def load_det_runs():\n","    \"\"\"Every finished cross-validation run on disk (all sessions) for the current arch / label definition.\"\"\"\n","    ms = [json.loads(f.read_text()) for f in (OUT / \"det_runs\").glob(f\"*_{CFG['det_label_def']}_{DET_ID}_s*_f*/metrics.json\")]\n","    df = pd.DataFrame([m for m in ms if m[\"fold\"] != \"ALL\" and m.get(\"regime\", \"patient_grouped\") == \"patient_grouped\"\n","                       and m[\"variant\"] in CFG[\"det_variants\"] and m[\"seed\"] in CFG[\"det_seeds\"]])\n","    return df.sort_values([\"fold\", \"seed\", \"variant\"]).reset_index(drop=True) if len(df) else df\n","det_df = load_det_runs()\n","print(f\"detector runs finished so far: {len(det_df)} / {len(CFG['det_variants']) * len(CFG['det_seeds']) * CFG['n_outer_folds']}\")\n","det_df.to_csv(OUT / \"tables/detection_runs.csv\", index=False)\n","cols = [c for c in [\"val_inner_AP50\", \"test_AP50\", \"test_F1\", \"test_center_F1\", \"test_frame_acc\", \"test_video_acc\", \"test_video_AUROC\"] if c in det_df.columns]\n","DET_COMPLETE = len(det_df) == len(CFG[\"det_variants\"]) * len(CFG[\"det_seeds\"]) * CFG[\"n_outer_folds\"]\n","if len(det_df):\n","    display(det_df.groupby(\"variant\")[cols].agg([\"mean\", \"std\", \"count\"]).round(3))\n","if DET_RUN_H:\n","    print(f\"this session: {len(DET_RUN_H)} detector runs, {np.mean(DET_RUN_H) * 60:.0f} min/run on average\")"]},{"cell_type":"markdown","id":"b56dec89","metadata":{"papermill":{"duration":0.023317,"end_time":"2026-11-18T11:10:18.250687+00:00","exception":false,"start_time":"2026-11-18T11:10:18.22737+00:00","status":"completed"},"tags":[]},"source":["## 8. Part A statistics: paired comparison against `raw`\n","Each hybrid is compared with `raw` on the same fold and seed (paired). The Wilcoxon signed-rank test is run over fold×seed pairs, with Holm correction across the three hybrid variants. With n < 6 pairs the test cannot reach p < 0.05; in that case only effect sizes are reported."]},{"cell_type":"code","execution_count":13,"id":"88fd13d4","metadata":{"execution":{"iopub.execute_input":"2026-11-18T11:10:18.299722Z","iopub.status.busy":"2026-11-18T11:10:18.299401Z","iopub.status.idle":"2026-11-18T