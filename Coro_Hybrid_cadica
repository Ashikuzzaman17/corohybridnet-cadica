s\"] = ep; CFG[\"save_weights\"] = True\n","        train_detector(variant, all_fold, 0, store_all)\n","        CFG[\"det_epochs\"] = saved_epochs; CFG[\"save_weights\"] = False\n","        model = build_detector(CFG[\"det_arch\"], variant).to(DEVICE)\n","        model.load_state_dict(torch.load(OUT / \"det_runs\" / f\"{variant}_{CFG['det_label_def']}_{DET_ID}_s0_fALL\" / \"weights.pt\"))\n","        ds = DetDataset(arc_frames, boxes.iloc[:0], arc_store, variant, \"L2\", False); ds.t = arc_t\n","        thr = det_df[det_df.variant == variant].test_thr.median()\n","        ext.append(dict(variant=variant, **det_metrics(predict(model, ds), arc_t, arc_frames, thr=thr)))\n","    ext = pd.DataFrame(ext); ext.to_csv(OUT / \"tables/external_arcade.csv\", index=False); display(ext.round(3))\n","else:\n","    why = [m for ok, m in [(bool(arc_imgs and arc_json), f\"no ARCADE stenosis/test images+annotations under ARCADE_ROOT={ARCADE_ROOT} \"\n","                                                         \"(add an ARCADE dataset with '+ Add Input', or set ARCADE_PATH)\"),\n","                           (not FAST_DEV, \"FAST_DEV is on\"),\n","                           (bool(DET_COMPLETE), \"not all detector runs are finished yet (resume in a new session)\"),\n","                           (budget_left(3.0), f\"less than 3 h of session budget left ({hours_used():.1f} h used of {TIME_BUDGET_H} h)\")] if not ok]\n","    print(\"ARCADE external validation skipped:\\n  - \" + \"\\n  - \".join(why))"]},{"cell_type":"markdown","id":"9010880f","metadata":{"papermill":{"duration":0.031472,"end_time":"2026-11-18T13:53:16.550979+00:00","exception":false,"start_time":"2026-11-18T13:53:16.519507+00:00","status":"completed"},"tags":[]},"source":["## 14. Hypothesis check (automatic, using the pre-registered rules)"]},{"cell_type":"code","execution_count":20,"id":"9a5628fc","metadata":{"execution":{"iopub.execute_input":"2026-11-18T13:53:16.617037Z","iopub.status.busy":"2026-11-18T13:53:16.6165