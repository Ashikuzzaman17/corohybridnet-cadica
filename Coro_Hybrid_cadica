   spl = [(idx[fid != k], idx[fid == k]) for k in range(n)]\n","    else:\n","        lv = bx.patient.map(bx.groupby(\"patient\")[\"level\"].max())\n","        spl = StratifiedGroupKFold(n, shuffle=True, random_state=seed).split(idx, lv.values, groups=bx.patient.values)\n","    grp = {\"frame_random\": np.arange(len(bx)), \"video_grouped\": bx.video.values}.get(regime, bx.patient.values)\n","    out = []\n","    for k, (tr, te) in enumerate(spl):\n","        rng = np.random.default_rng(seed + k)\n","        g_tr = rng.permutation(np.unique(grp[tr]))\n","        g_va = set(g_tr[:len(g_tr) // 6])\n","        is_va = np.array([g in g_va for g in grp[tr]])\n","        out.append((bx.iloc[tr[~is_va]], bx.iloc[tr[is_va]], bx.iloc[te]))   # val drawn in the same (leaky or not) way\n","    return out\n","\n","leak_file = OUT / \"tables/partD_leakage_severity.csv\"\n","nfold = 2 if FAST_DEV else CFG[\"n_outer_folds\"]\n","leak_folds = list(range(nfold)) if FAST_DEV else FOLDS_TO_RUN      # same session split as the other experiments\n","leak_runs = []\n","for regime in [\"frame_random\", \"video_grouped\", \"patient_grouped\"]:\n","    for seed in CFG[\"sev_seeds\"]:\n","        for k, (tr, va, te) in enumerate(regime_folds(sev_boxes.reset_index(drop=True), regime, nfold, seed)):\n","            f = OUT / \"sev_runs/leak\" / f\"{regime}_s{seed}_f{k}.json\"\n","            leak_runs.append(f)\n","            if f.exists() or k not in leak_folds or not budget_left(0.2):\n","                continue\n","            _, pt = train_severity(\"cnn_raw\", tr, va, te, seed, cs)\n","            f.write_text(json.dumps(dict(regime=regime, seed=seed, fold=k, **sev_metrics(te.level.values, pt)), default=float))\n","            print(f\"  leakage {regime} seed{seed} fold{k} done\", flush=True)\n","leak = pd.DataFrame([json.loads(f.read_text()) for f in leak_runs if f.exists()])\n","print(f\"leakage runs finished so far: {len(leak)} / {len(leak_runs)}\")\n","leak.to_csv(leak_file, index=False)\n","LEAK_COMPLETE = len(leak) == len(leak_runs)\n","if len(leak):\n","    display(leak.groupby(\"regime\")[[\"QWK\", \"MAE\", \"acc_pm1\"]].agg([\"mean\", \"std\", \"count\"]).round(3))"]},{"cell_type":"markdown","id":"5e39eb59","metadata":{"papermill":{"duration":0.021032,"end_time":"2026-11-08T20:36:46.690039+00:00","exception":false,"start_time":"2026-11-08T20:36:46.669007+00:00","status":"completed"},"tags":[]},"source":["### 11.1 Detector leakage: the same experiment for stenosis detection\n","\n","Most published CADICA detectors report frame-level splits. The `raw` detector (seed 0) is trained and tested under **frame-random** and **video-grouped** splits with otherwise identical settings; the **patient-grouped** numbers are the seed-0 `raw` runs of the main grid (Section 7). The validation set is drawn in the same (leaky or not) way as the test set, exactly as a leaky paper would do it."]},{"cell_type":"code","execution_count":17,"id":"70ff9db9","metadata":{"execution":{"iopub.execute_input":"2026-11-08T20:36:46.732069Z","iopub.status.busy":"2026-11-08T20:36:46.731825Z","iopub.status.idle":"2026-11-08T21:57:17.951519Z","shell.execute_reply":"2026-11-08T21:57:17.950852Z"},"papermill":{"duration":4831.269266,"end_time":"2026-11-08T21:57:17.979322+00:00","exception":false,"start_time":"2026-11-08T20:36:46.710056+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["0 of 10 detector-leakage runs already finished\n","  [raw_L2_mobilenet800_s0_fframe_random0 cuda:1] ep0 loss=0.104 val AP50=0.168 F1=0.260 (133s)\n","  [raw_L2_mobilenet800_s0_fframe_random1 cuda:0] ep0 loss=0.109 val AP50=0.139 F1=0.248 (134s)\n","  [raw_L2_mobilenet800_s0_fframe_random0 cuda:1] ep1 loss=0.170 val AP50=0.436 F1=0.483 (252s)\n","  [raw_L2_mobilenet800_s0_fframe_random1 cuda:0] ep1 loss=0.166 val AP50=0.326 F1=0.381 (253s)\n","  [raw_L2_mobilenet800_s0_fframe_random1 cuda:0] ep2 loss=0.216 val AP50=0.575 F1=0.593 (368s)\n","  [raw_L2_m