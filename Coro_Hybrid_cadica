ity.csv\"\n","nfold = 2 if FAST_DEV else CFG[\"n_outer_folds\"]\n","leak_folds = list(range(nfold)) if FAST_DEV else FOLDS_TO_RUN      # same session split as the other experiments\n","leak_runs = []\n","for regime in [\"frame_random\", \"video_grouped\", \"patient_grouped\"]:\n","    for seed in CFG[\"sev_seeds\"]:\n","        for k, (tr, va, te) in enumerate(regime_folds(sev_boxes.reset_index(drop=True), regime, nfold, seed)):\n","            f = OUT / \"sev_runs/leak\" / f\"{regime}_s{seed}_f{k}.json\"\n","            leak_runs.append(f)\n","            if f.exists() or k not in leak_folds or not budget_left(0.2):\n","                continue\n","            _, _, pt = train_severity(\"cnn_raw\", tr, va, te, seed, cs)\n","            f.write_text(json.dumps(dict(regime=regime, seed=seed, fold=k, **sev_metrics(te.level.values, pt)), default=float))\n","            print(f\"  leakage {regime} seed{seed} fold{k} done\", flush=True)\n","leak = pd.DataFrame([json.loads(f.read_text()) for f in leak_runs if f.exists()])\n","print(f\"leakage runs finished so far: {len(leak)} / {len(leak_runs)}\")\n","leak.to_csv(leak_file, index=False)\n","LEAK_COMPLETE = len(leak) == len(leak_runs)\n","if len(leak):\n","    display(leak.groupby(\"regime\")[[c for c in [\"QWK\", \"MAE\", \"acc\", \"acc_pm1\"] if c in leak.columns]].agg([\"mean\", \"std\", \"count\"]).round(3))"]},{"cell_type":"markdown","id":"8a0ea273","metadata":{"papermill":{"duration":0.028859,"end_time":"2026-11-18T13:20:40.489626+00:00","exception":false,"start_time":"2026-11-18T13:20:40.460767+00:00","status":"completed"},"tags":[]},"source":["### 11.1 Detector leakage: the same experiment for stenosis detection\n","\n","Most published CADICA detectors report frame-level splits. The `raw` detector (seed 0) is trained and tested under **frame-random** and **video-grouped** splits with otherwise identical settings; the **patient-grouped** numbers are the seed-0 `raw` runs of the main grid (Section 7). The validation 