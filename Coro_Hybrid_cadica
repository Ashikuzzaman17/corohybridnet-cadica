> cnn_raw, QWK) -0.063024   \n","8                  H4 (track aggregation > box-level)  0.038436   \n","9         H6 (frame-random inflates vs patient split)  0.328291   \n","10  H7 (frame-random inflates detection AP50 vs pa...  0.796642   \n","\n","                        ci    verdict  \n","0         [-0.075, -0.028]   rejected  \n","1         [-0.060, -0.013]   rejected  \n","2           [0.004, 0.063]  supported  \n","3           [0.004, 0.046]  supported  \n","4           [0.194, 0.358]  supported  \n","5                  seeds=3   rejected  \n","6                  seeds=3   rejected  \n","7                  seeds=3   rejected  \n","8         see tables/partC      trend  \n","9   patient-split SD=0.110  supported  \n","10  patient-split SD=0.050  supported  "]},"metadata":{},"output_type":"display_data"}],"source":["def ci_of_diff(df, a, b, metric):\n","    d = (df[df.variant == a].set_index([\"fold\", \"seed\"])[metric] - df[df.variant == b].set_index([\"fold\", \"seed\"])[metric]).dropna()\n","    if len(d) < 2:\n","        return d.mean(), np.nan, np.nan\n","    bs = [np.mean(np.random.default_rng(i).choice(d.values, len(d))) for i in range(2000)]\n","    return d.mean(), *np.percentile(bs, [2.5, 97.5])\n","\n","H = []\n","for v in ([v for v in CFG[\"det_variants\"] if v in (\"frangi_early\", \"frangi_gated\", \"temporal\", \"clahe\")] if len(det_df) else []):\n","    hname = \"H5\" if v == \"temporal\" else \"H1\"\n","    for metric in [\"test_F1\", \"test_AP50\"]:\n","        m, lo, hi = ci_of_diff(det_df, v, \"raw\", metric)\n","        H.append(dict(H=f\"{hname} ({v} > raw, detection {metric[5:]})\", estimate=m, ci=f\"[{lo:.3f}, {hi:.3f}]\",\n","                      verdict=\"supported\" if lo > 0 else (\"rejected\" if not np.isnan(lo) else \"insufficient runs\")))\n","best_rho = pilot[pilot.subset == \"all grades\"].sort_values(\"ci_lo\").iloc[-1]\n","H.append(dict(H=\"H2 (descriptor tracks grade)\", estimate=best_rho.spearman, ci=f\"[{best_rho.ci_lo: