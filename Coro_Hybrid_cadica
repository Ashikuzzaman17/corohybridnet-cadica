G[\"fast_dev_max_frames\"] // 42 + 2)\n","build_frangi_cache(det_frames)\n","store = FrameStore(det_frames)\n","# seed-major order: every variant gets seed 0 on all folds first, so a partial grid is still a balanced comparison\n","det_jobs = [(variant, fold, seed) for seed in CFG[\"det_seeds\"] for fold in [FOLDS[i] for i in FOLDS_TO_RUN]\n","            for variant in CFG[\"det_variants\"]]\n","DET_RUN_H = []                                       # durations of runs trained in this session (for the time budget)\n","def det_done(job):\n","    v, f, s = job\n","    return (OUT / \"det_runs\" / f\"{v}_{CFG['det_label_def']}_{DET_ID}_s{s}_f{f['fold']}\" / \"metrics.json\").exists()\n","def det_budget_ok(reserve_h):\n","    est = max(DET_RUN_H) if DET_RUN_H else CFG.get(\"det_run_est_h\", 1.0)\n","    return budget_left(est + reserve_h)\n","def run_det_job(job, dev=None, reserve_h=1.5):     # main grid keeps ~1.5 h for severity / leakage / summaries\n","    if det_done(job):\n","        return train_detector(*job, store, device=dev)\n","    if not det_budget_ok(reserve_h):\n","        return None\n","    t = time.time()\n","    m = train_detector(*job, store, device=dev)\n","    DET_RUN_H.append((time.time() - t) / 3600)\n","    return m\n","print(f\"{sum(map(det_done, det_jobs))} of {len(det_jobs)} detector runs already finished\", flush=True)\n","print(f\"{len(det_jobs)} detector runs on {len(GPUS)} GPU(s); finished runs are skipped (resumable)\", flush=True)\n","import queue\n","def run_det_jobs(jobs, reserve_h=1.5):\n","    \"\"\"Runs detector jobs, one per GPU at a time; finished runs are loaded, budget-exceeding runs are skipped.\"\"\"\n","    if len(GPUS) == 1:\n","        return [run_det_job(j, None, reserve_h) for j in jobs]\n","    free_gpus = queue.Queue()\n","    for g in GPUS:\n","        free_gpus.put(g)\n","    def _det_job(job):\n","        dev = free_gpus.get()                        # each GPU trains one run at a time\n","        try:\n","            with torch.cuda.device(dev):\n","                return run_det_job(job, dev, reserve_h)\n","        finally:\n","            torch.cuda.empty_cache(); free_gpus.put(dev)\n","    return Parallel(n_jobs=len(GPUS), prefer=\"threads\")(delayed(_det_job)(j) for j in jobs)\n","det_results = run_det_jobs(det_jobs)\n","def load_det_runs():\n","    \"\"\"Every finished cross-validation run on disk (all sessions) for the current arch / label definition.\"\"\"\n","    ms = [json.loads(f.read_text()) for f in (OUT / \"det_runs\").glob(f\"*_{CFG['det_label_def']}_{DET_ID}_s*_f*/metrics.json\")]\n","    df = pd.DataFrame([m for m in ms if m[\"fold\"] != \"ALL\" and m.get(\"regime\", \"patient_grouped\") == \"patient_grouped\"\n","                       and m[\"variant\"] in CFG[\"det_variants\"] and m[\"seed\"] in CFG[\"det_seeds\"]])\n","    return df.sort_values([\"fold\", \"seed\", \"variant\"]).reset_index(drop=True) if len(df) else df\n","det_df = load_det_runs()\n","print(f\"detector runs finished so far: {len(det_df)} / {len(CFG['det_variants']) * len(CFG['det_seeds']) * CFG['n_outer_folds']}\")\n","det_df.to_csv(OUT / \"tables/detection_runs.csv\", index=False)\n","cols = [\"test_AP50\", \"test_F1\", \"test_center_F1\", \"test_iou03_F1\", \"test_sens@0.5FPpi\", \"test_video_AUROC\"]\n","DET_COMPLETE = len(det_df) == len(CFG[\"det_variants\"]) * len(CFG[\"det_seeds\"]) * CFG[\"n_outer_folds\"]\n","if len(det_df):\n","    display(det_df.groupby(\"variant\")[cols].agg([\"mean\", \"std\", \"count\"]).round(3))\n","if DET_RUN_H:\n","    print(f\"this session: {len(DET_RUN_H)} detector runs, {np.mean(DET_RUN_H) * 60:.0f} min/run on average\")"]},{"cell_type":"markdown","id":"928d39b0","metadata":{"papermill":{"duration":0.017559,"end_time":"2026-11-08T19:13:44.619948+00:00","exception":false,"start_time":"2026-11-08T19:13:44.602389+00:00","status":"completed"},"tags":[]},"source":["## 8. Part A statistics: paired comparison against `raw`\n","Each hybrid is compared with `raw` on the same fold and seed (paired). The Wilcoxon signed-rank test is run over fold×seed pairs, with Holm correction across the three hybrid variants. With n < 6 pairs the test cannot reach p < 0.05; in that case only effect sizes are reported."]},{"cell_type":"code","execution_count":13,"id":"585abea1","metadata":{"execution":{"iopub.execute_input":"2026-11-08T19:13:44.655183Z","iopub.status.busy":"2026-11-08T19:13:44.65479Z","iopub.status.idle":"2026-11-08T19:13:44.710352Z","shell.execute_reply":"2026-11-08T19:13:44.709533Z"},"papermill":{"duration":0.075024,"end_time":"2026-11-08T19:13:44.712012+00:00","exception":false,"start_time":"2026-11-08T19:13:44.636988+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>variant</th>\n","      <th>metric</th>\n","      <th>n_pairs</th>\n","      <th>mean_diff</th>\n","      <th>sd_diff</th>\n","      <th>p</th>\n","      <th>p_holm</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>frangi_early</td>\n","      <td>test_AP50</td>\n","      <td>10</td>\n","      <td>-0.0378</td>\n","      <td>0.0390</td>\n","      <td>0.0371</td>\n","      <td>0.0742</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>frangi_gated</td>\n","      <td>test_AP50</td>\n","      <td>10</td>\n","      <td>0.0248</td>\n","      <td>0.0382</td>\n","      <td>0.0371</td>\n","      <td>0.0742</td>\n","    </tr>\n","    <tr>\n","      <th>0</th>\n","      <td>frangi_early</td>\n","      <td>test_F1</td>\n","      <td>10</td>\n","      <td>-0.0525</td>\n","     