  df.to_csv(PAPER / \"tables\" / f\"{name}.csv\", index=index)\n","    try:                                              # pandas' LaTeX export needs jinja2\n","        (PAPER / \"tables\" / f\"{name}.tex\").write_text(df.to_latex(index=index, float_format=\"%.3f\"), encoding=\"utf-8\")\n","    except Exception as e:\n","        print(f\"  ({name}.tex not written: {e!r})\")\n","    CAPTIONS[f\"tables/{name}\"] = caption\n","    display(df)\n","\n","def ci_str(est, lo, hi, d=3):\n","    return f\"{est:.{d}f} [{lo:.{d}f}, {hi:.{d}f}]\"\n","\n","def msd_str(s, d=3):\n","    s = pd.Series(s, dtype=float).dropna()\n","    return f\"{s.mean():.{d}f} ± {s.std():.{d}f}\" if len(s) > 1 else (f\"{s.mean():.{d}f}\" if len(s) else \"–\")\n","\n","def iqr_str(s, d=0):\n","    q = np.percentile(s, [50, 25, 75])\n","    return f\"{q[0]:.{d}f} [{q[1]:.{d}f}–{q[2]:.{d}f}]\"\n","\n","# ---- Table 1a: dataset ---------------------------------------------------------------------------------------\n","vids = frames.groupby(\"video\").agg(patient=(\"patient\", \"first\"), lesion=(\"lesion_video\", \"first\"),\n","                                   n_key=(\"frame\", \"size\"), n_frames=(\"video_len\", \"first\"))\n","lesion_v = vids.lesion.astype(str).str.lower().eq(\"true\")\n","t1 = pd.DataFrame([\n","    (\"Patients\", frames.patient.nunique()),\n","    (\"Videos (selected)\", len(vids)),\n","    (\"  lesion / non-lesion videos\", f\"{int(lesion_v.sum())} / {int((~lesion_v).sum())}\"),\n","    (\"Videos per patient, median [IQR]\", iqr_str(vids.groupby(\"patient\").size())),\n","    (\"Frames in selected videos\", int(vids.n_frames.sum())),\n","    (\"Keyframes\", len(frames)),\n","    (\"  with ≥1 lesion box\", int((frames.n_boxes > 0).sum())),\n","    (\"Keyframes per video, median [IQR]\", iqr_str(vids.n_key)),\n","    (\"Lesion boxes\", len(boxes)),\n","    (\"  ≥50% stenosis (positives under L2)\", int((boxes.level >= 2).sum())),\n","    (\"Lesion tracks (linked across keyframes)\", boxes.track.nunique()),\n","    (\"Box side √(w·h), px, median [IQR]\", iqr_str(np.sqrt(boxes.w * boxes.h))),\n","    (\"Frame size, px\", \" × \".join(map(str, load_gray(frames.path.iloc[0]).shape))),\n","], columns=[\"Item\", \"Value\"])\n","save_table(t1, \"table1a_dataset\", \"CADICA dataset summary (selected videos). Lesion tracks are built by the linking rule of Section 3.1.\")\n","\n","t1g = pd.DataFrame({\"Grade\": GRADES, \"5-level class\": [LEVEL_NAMES[LEVEL5[g]] for g in GRADES],\n","                    \"Boxes\": boxes.grade.value_counts().reindex(GRADES).fillna(0).astype(int).values,\n","                    \"Tracks\": boxes.groupby(\"grade\").track.nunique().reindex(GRADES).fillna(0).astype(int).values,\n","                    \"Patients\": boxes.groupby(\"grade\").patient.nunique().reindex(GRADES).fillna(0).astype(int).values})\n","t1g.insert(3, \"Boxes (%)\", (100 * t1g.Boxes / t1g.Boxes.sum()).round(1))\n","save_table(t1g, \"table1b_grades\", \"Distribution of the seven annotated stenosis grades and the pre-registered 5-level ordinal target \"\n","           \"(p99 and p100 merged into ≥90%). A track or patient can carry several grades.\")\n","\n","# ---- Table 1c: patient characteristics (metadata.xlsx) -------------------------------------------------------\n","def _norm(s):\n","    return re.sub(r\"[\\s\\-]+\", \"\", str(s)).lower()\n","INDICATION = {\"nonstsegmentelevationacutecoronarysyndrome\": \"NSTE-ACS\", \"stsegmentelevationacutecoronarysyndrome\": \"STE-ACS\",\n","              \"stableangina\": \"Stable angina\"}\n","if meta is not None:\n","    m = meta[meta.patient.isin(frames.patient.unique())].copy()\n","    num = lambda c: pd.to_numeric(m[c], errors=\"coerce\")\n","    npct = lambda mask: f\"{int(mask.sum())} ({100 * mask.mean():.0f}%)\"\n","    rows = [(\"Patients with metadata\", str(len(m))),\n","            (\"Age, years, mean ± SD\", msd_str(num(\"Age (years)\"), 1)),\n","            (\"Male sex, n (%)\", npct(m[\"Sex\"].astype(str).str.strip().str.upper().eq(\"M\")))]\n","    if \"BMI\" in m:\n","        bmi = num(\"BMI\"); rows.append((\"BMI, kg/m², mean ± SD\", msd_str(bmi[bmi > 0], 1)))\n","    for c in [\"Diabetes mellitus\", \"Dyslipidemia\", \"Smoker\", \"High blood pressure\", \"Kidney failure\", \"Heart failure\", \"Atrial fibrillation\"]:\n","        if c in m:\n","            rows.append((f\"{c}, n (%)\", npct(num(c).fillna(0) > 0)))\n","    cats = [(\"Clinical indication for angiogrphy\", \"Indication\", lambda s: INDICATION.get(_norm(s), str(s).strip())),\n","            (\"Left ventricular ejection fraction\", \"LVEF\", lambda s: str(s).replace(\" \", \"\")),\n","            (\"Number of vessels affected\", \"Vessels affected\", lambda s: str(s).strip()),\n","            (\"Maximum degree of the coronary artery involvement\", \"Maximum stenosis (clinical)\", lambda s: str(s).replace(\" \", \"\"))]\n","    for c, label, f in cats:\n","        if c in m:\n","            vc = m[c].dropna().map(f).value_counts()\n","            rows += [(f\"{label}: {k}, n (%)\", f\"{v} ({100 * v / len(m):.0f}%)\") for k, v in vc.items()]\n","            if m[c].isna().any():\n","                rows.append((f\"{label}: missing, n\", str(int(m[c].isna().sum()))))\n","    save_table(pd.DataFrame(rows, columns=[\"Characteristic\", \"Value\"]), \"table1c_cohort\",\n","               \"Patient characteristics from CADICA metadata.xlsx (category spellings harmonised).\")\n","else:\n","    print(\"metadata.xlsx not available - Table 1c skipped\")\n","\n","# ---- Table S1: patient-level splits ----------------------------------------------------------------------------\n","spl = []\n","for f in FOLDS:\n","    for part in (\"train\", \"val\", \"test\"):\n","        fr, bx = frames[frames.patient.isin(f[part])], boxes[boxes.patient.isin(f[part])]\n","        spl.append(dict(fold=f[\"fold\"], split=part, patients=len(f[part]), videos=fr.video.nunique(), keyframes=len(fr),\n","                        boxes=len(bx), boxes_ge50=int((bx.level >= 2).sum())))\n","save_table(pd.DataFrame(spl), \"tableS1_splits\", \"Pre-registered patient-level splits (5 outer folds; validation ≈ 1/6 of the \"\n","           \"training patients, used only for early stopping and threshold choice). Fold membership is frozen in protocol.json.\")\n","\n","KEY[\"dataset\"] = dict(patients=int(frames.patient.nunique()), videos=len(vids), lesion_videos=int(lesion_v.sum()),\n","                      keyframes=len(frames), keyframes_with_boxes=int((frames.n_boxes > 0).sum()), boxes=len(boxes),\n","                      boxes_ge50=int((boxes.level >= 2).sum()), tracks=int(boxes.track.nunique()))\n","KEY[\"complete\"] = dict(detection=DET_COMPLETE, severity=SEV_COMPLETE, leakage=LEAK_COMPLETE, detector_leakage=DET_LEAK_COMPLETE,\n","                       fast_dev=FAST_DEV)\n"]},{"cell_type":"code","execution_count":22,"id":"1258098d","metadata":{"execution":{"iopub.execute_input":"2026-11-08T21:57:23.458634Z","iopub.status.busy":"2026-11-08T21:57:23.458352Z","iopub.status.idle":"2026-11-08T21:57:28.695495Z","shell.execute_reply":"2026-11-08T21:57:28.694845Z"},"papermill":{"duration":5.264322,"end_time":"2026-11-08T21:57:28.697181+00:00","exception":false,"start_time":"2026-11-08T21:57:23.432859+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1050x290 with 3 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 900x720 with 15 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 1000x320 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }